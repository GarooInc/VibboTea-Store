{% doc %}
  @prompt
    Create a "New" badge that displays on product cards and product pages when a product has the tag "new". The badge should be visually consistent with the store's premium tea brand aesthetic — clean, minimal, and elegant. It should appear as an overlay on the product image or near the product title. The badge should only show when the product tag "new" is present.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if product.tags contains 'new' or product.tags contains 'New' or product.tags contains 'NEW' %}
  {% style %}
    .ai-new-badge-{{ ai_gen_id }} {
      display: inline-block;
      position: {{ block.settings.position_type }};
      {% if block.settings.position_type == 'absolute' %}
        top: {{ block.settings.vertical_position }}px;
        left: {{ block.settings.horizontal_position }}px;
        z-index: 10;
      {% endif %}
      padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
      background-color: {{ block.settings.badge_background }};
      color: {{ block.settings.badge_text_color }};
      font-size: {{ block.settings.font_size }}px;
      font-weight: {{ block.settings.font_weight }};
      text-transform: {{ block.settings.text_transform }};
      letter-spacing: {{ block.settings.letter_spacing }}px;
      border-radius: {{ block.settings.border_radius }}px;
      {% if block.settings.show_border %}
        border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
      {% endif %}
      {% if block.settings.show_shadow %}
        box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
      {% endif %}
      line-height: 1;
      white-space: nowrap;
    }

    @media screen and (max-width: 749px) {
      .ai-new-badge-{{ ai_gen_id }} {
        font-size: {{ block.settings.font_size | times: 0.9 }}px;
        padding: {{ block.settings.padding_vertical | times: 0.9 }}px {{ block.settings.padding_horizontal | times: 0.9 }}px;
      }
    }
  {% endstyle %}

  <span class="ai-new-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {{ block.settings.badge_text }}
  </span>
{% endif %}

{% schema %}
{
  "name": "New badge",
  "settings": [
    {
      "type": "header",
      "content": "Badge content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "New"
    },
    {
      "type": "paragraph",
      "content": "Badge appears when product has the tag 'new'"
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "select",
      "id": "position_type",
      "label": "Position type",
      "options": [
        {
          "value": "relative",
          "label": "Inline with content"
        },
        {
          "value": "absolute",
          "label": "Overlay on image"
        }
      ],
      "default": "absolute",
      "info": "Choose 'Overlay' for product cards, 'Inline' for near product title"
    },
    {
      "type": "range",
      "id": "horizontal_position",
      "label": "Horizontal position",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15,
      "info": "Only applies when position is set to 'Overlay'"
    },
    {
      "type": "range",
      "id": "vertical_position",
      "label": "Vertical position",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15,
      "info": "Only applies when position is set to 'Overlay'"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Background color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 4,
      "max": 16,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show border",
      "default": false
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 1,
      "max": 3,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Shadow"
    },
    {
      "type": "checkbox",
      "id": "show_shadow",
      "label": "Show shadow",
      "default": true
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 0.5,
      "step": 0.1,
      "default": 0.2
    }
  ],
  "presets": [
    {
      "name": "New badge"
    }
  ]
}
{% endschema %}
