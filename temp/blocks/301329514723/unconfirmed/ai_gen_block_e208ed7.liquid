{% doc %}
  @prompt
    Create a product page block called "Discount Badge" that displays a % OFF badge dynamically calculated from the product's compare_at_price and price. The badge should appear inline next to or just above the product price area. It should only show when a compare_at_price exists and is higher than the current price. The badge should have a bold, eye-catching style (e.g. pill shape, accent color background) that fits a premium tea brand aesthetic. The block should have a toggle/enable setting so the merchant can easily show or hide it from the theme editor, and optionally a color picker for the badge background and text color.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if block.settings.show_badge %}
  {% assign compare_price = product.selected_or_first_available_variant.compare_at_price %}
  {% assign current_price = product.selected_or_first_available_variant.price %}
  
  {% if compare_price and compare_price > current_price %}
    {% assign discount_amount = compare_price | minus: current_price %}
    {% assign discount_percentage = discount_amount | times: 100.0 | divided_by: compare_price | round %}
    
    {% style %}
      .ai-discount-badge-{{ ai_gen_id }} {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
        background-color: {{ block.settings.badge_background_color }};
        color: {{ block.settings.badge_text_color }};
        border-radius: {{ block.settings.badge_border_radius }}px;
        font-size: {{ block.settings.badge_font_size }}px;
        font-weight: {{ block.settings.badge_font_weight }};
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin: {{ block.settings.badge_margin_vertical }}px {{ block.settings.badge_margin_horizontal }}px;
        width: {{ block.settings.desktop_width_percent }}%;
        max-width: 100%;
      }

      .ai-discount-badge__text-{{ ai_gen_id }} {
        white-space: nowrap;
      }

      @media screen and (max-width: 749px) {
        .ai-discount-badge-{{ ai_gen_id }} {
          font-size: {{ block.settings.badge_font_size | times: 0.9 }}px;
        }
      }
    {% endstyle %}

    <div class="ai-discount-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
      <span class="ai-discount-badge__text-{{ ai_gen_id }}">
        {{ discount_percentage }}% {{ block.settings.badge_text }}
      </span>
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Discount badge",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show discount badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "OFF",
      "info": "Text that appears after the percentage (e.g., '25% OFF')"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Background color",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "badge_font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "badge_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "badge_padding_vertical",
      "label": "Padding vertical",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "badge_padding_horizontal",
      "label": "Padding horizontal",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "badge_margin_vertical",
      "label": "Margin vertical",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "badge_margin_horizontal",
      "label": "Margin horizontal",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Discount badge"
    }
  ]
}
{% endschema %}
