{% doc %}
  @prompt
    Create a product page block called "Discount Badge" that displays a % OFF badge dynamically calculated from the product's compare_at_price and price. The badge should appear inline next to or just above the product price area. It should only show when a compare_at_price exists and is higher than the current price. The badge should have a bold, eye-catching style (e.g. pill shape, accent color background) that fits a premium tea brand aesthetic. The block should have a toggle/enable setting so the merchant can easily show or hide it from the theme editor, and optionally a color picker for the badge background and text color.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if block.settings.show_badge and product.compare_at_price > product.price %}
  {% assign discount_amount = product.compare_at_price | minus: product.price %}
  {% assign discount_percentage = discount_amount | times: 100.0 | divided_by: product.compare_at_price | round %}

  {% style %}
    .ai-discount-badge-{{ ai_gen_id }} {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
      background-color: {{ block.settings.badge_bg_color }};
      color: {{ block.settings.badge_text_color }};
      border-radius: {{ block.settings.badge_border_radius }}px;
      font-size: {{ block.settings.badge_font_size }}px;
      font-weight: {{ block.settings.badge_font_weight }};
      letter-spacing: 0.5px;
      text-transform: uppercase;
      white-space: nowrap;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
    }

    @media screen and (max-width: 749px) {
      .ai-discount-badge-{{ ai_gen_id }} {
        font-size: {{ block.settings.badge_font_size | times: 0.9 }}px;
        padding: {{ block.settings.badge_padding_vertical | times: 0.85 }}px {{ block.settings.badge_padding_horizontal | times: 0.85 }}px;
      }
    }
  {% endstyle %}

  <div class="ai-discount-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {{ discount_percentage }}% OFF
  </div>
{% endif %}

{% schema %}
{
  "name": "Discount badge",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show discount badge",
      "default": true,
      "info": "Badge appears when compare at price is higher than current price"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Badge style"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Background color",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "badge_font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "badge_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "badge_padding_vertical",
      "label": "Vertical padding",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "badge_padding_horizontal",
      "label": "Horizontal padding",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Discount badge"
    }
  ]
}
{% endschema %}
