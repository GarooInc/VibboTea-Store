<div
  class="slider-facts-{{ section.id }} custom-slider relative flex flex-col md:block
         w-screen
         mx-auto overflow-hidden"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.Time }}"
  style="margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);"
>


  <link href="{{ 'sections-header.css' | asset_url }}" rel="stylesheet" />

  <div id="hero-header-spacer" class="md:hidden relative w-full bg-white"></div>
  <div class="slides-wrapper hero-slides-wrapper relative w-full overflow-hidden">
    {% for block in section.blocks %}
      <div class="slide hero-slide absolute inset-0 w-full h-full {% if forloop.first %}active{% endif %}">
        <div class="hero-media">

          
          {% if block.settings.video_mp4 != blank %}
            <video
             class="hero-slide-media"
              autoplay
              muted
              loop
              playsinline
            >
              <source src="{{ block.settings.video_mp4 }}" type="video/mp4">
            </video>

          {% elsif block.settings.image_desktop %}
            {% if block.settings.image_mobile %}
              <img
                src="{{ block.settings.image_mobile | image_url: width: 1500 }}"
                class="hero-slide-media md:hidden"
                alt="{{ block.settings.alt | escape }}"
                width="{{ block.settings.image_mobile.width }}"
                height="{{ block.settings.image_mobile.height }}"
              />
              <img
                src="{{ block.settings.image_desktop | image_url: width: 3000 }}"
                class="hero-slide-media hidden md:block"
                alt="{{ block.settings.alt | escape }}"
                width="{{ block.settings.image_desktop.width }}"
                height="{{ block.settings.image_desktop.height }}"
              />
            {% else %}
              <img
                src="{{ block.settings.image_desktop | image_url: width: 3000 }}"
                class="hero-slide-media"
                alt="{{ block.settings.alt | escape }}"
                width="{{ block.settings.image_desktop.width }}"
                height="{{ block.settings.image_desktop.height }}"
              />
            {% endif %}
          {% endif %}
        </div>

        <div class="slide-content hero-copy">
          {% if block.settings.page_title != blank %}
            <h1 class="hero-copy-title">
              {{ block.settings.page_title | newline_to_br }}
              {% if block.settings.title_logo %}
                <img src="{{ block.settings.title_logo | image_url: width: 800 }}" alt="VIBBO" width="800" height="200" class="hero-title-logo" style="height: 0.85em; width: auto; display: inline-block; vertical-align: middle; max-width: 40vw; margin-left: 0.3em;">
              {% endif %}
            </h1>
          {% endif %}

          {% if block.settings.page_descripction != blank %}
            <p class="hero-copy-desc">
              {{- block.settings.page_descripction | newline_to_br -}}
              <span class="whitespace-nowrap">&nbsp;WARRANTY{%- if block.settings.link_popup -%}
                <span class="hero-disclaimer-trigger relative inline-block align-middle z-50 ml-2">
                  <button
                    type="button"
                    class="w-5 h-5 rounded-full border border-black bg-white text-black text-xs font-bricolage flex items-center justify-center"
                    aria-label="Show disclaimer"
                    aria-expanded="false"
                  >
                    i
                  </button>

                  <span class="hero-disclaimer-tooltip">
                    <span class="hero-disclaimer-tooltip-inner">
                      {{ block.settings.hover_text }}
                    </span>
                  </span>
                </span>
              {%- endif -%}</span>
            </p>
          {% endif %}

        </div>

        <div class="slide-content md:hidden absolute inset-0 flex flex-col justify-center
            items-start px-5 md:px-10 z-40">
          
          {% if block.settings.title_sec != blank %}
            <h1 class="text-2xl md:text-5xl lg:text-7xl font-bricolage font-bold text-white leading-tight">
              {{ block.settings.title_sec | newline_to_br }}
            </h1>
          {% endif %}

          {% if block.settings.desc_sec != blank %}
            <p class="mt-2 md:mt-4 text-sm md:text-lg font-bricolage text-white">
              {{ block.settings.desc_sec }}
            </p>
          {% endif %}
        </div>

        <div class="slide-content md:absolute hidden md:top-45 top-5 md:pl-10 pl-5 left-0 w-full h-[40vh] md:h-screen
              md:flex flex-col items-left justify-center text-left overflow-hidden ">
          
          {% if block.settings.title_sec != blank %}    
            <h1 class="lg:text-7xl md:text-5xl text-2xl font-bold font-bricolage text-white
              drop-shadow-lg leading-[0.9] ">
              {{ block.settings.title_sec | newline_to_br  }}
            </h1>
          {% endif %}

          {% if block.settings.desc_sec != blank %}    
            <p class="lg:text-xl md:text-lg md:pt-4 pt-2 pl-2 text-white
               font-bricolage drop-shadow-lg leading-[0.9] ">
              {{ block.settings.desc_sec }}
            </p>
          {% endif %}

        </div>
        {% comment %} boton {% endcomment %}
      {% assign position = block.settings.button_position %}

      {% case position %}
        {% when 'top-left' %}
          {% assign position_classes = 'items-start justify-start md:pt-[78px] pt-10 pl-10' %}
        {% when 'top-center' %}
          {% assign position_classes = 'items-start justify-center pt-48' %}
        {% when 'top-right' %}
          {% assign position_classes = 'items-start justify-end pt-10 pr-10' %}
        {% when 'center' %}
          {% assign position_classes = 'items-center justify-center md:pt-80 pt-52 md:left-0 left-1/3' %}
        {% when 'bottom-left' %}
          {% assign position_classes = 'items-end justify-start md:pb-[42px] md:pl-10 md:pt-0 pt-52 pl-5' %}
        {% when 'bottom-left-up' %}
          {% assign position_classes = 'items-end justify-start md:pb-[122px] pb-40 pl-10' %}
        {% when 'bottom-right' %}
          {% assign position_classes = 'items-end justify-end pb-20 pr-10' %}
        {% else %}
        {% when 'bottom-center' %}
          {% assign position_classes = 'items-end justify-center md:pb-20 pt-55 mt-10 md:mt-0 md:pl-0 pl-5 md:pt-0 md:left-0 left-1/3' %}
        {% else %}
          {% assign position_classes = 'items-end justify-center pb-20' %}
      {% endcase %}



      {% if position == 'bottom-center' %}
        <div class="hero-cta-bottom-center">
          <a
            href="{{ block.settings.button_link | default: '/collections/frontpage' }}"
            class="hero-cta-button"
          >
            <span class="hero-cta-label">
              {{ block.settings.button_text }}
            </span>
          </a>
        </div>
      {% else %}
        <div class="absolute inset-0 md:flex {{ position_classes }} z-50 pointer-events-none">
          <a
            href="{{ block.settings.button_link | default: '/collections/frontpage' }}"
            class="pointer-events-auto bg-[#FFCD51] flex items-center justify-center
                  rounded-3xl px-6 py-3 w-40 md:px-8 md:py-3 md:w-55 hover:opacity-70 transition-opacity"
          >
            <span class="font-bricolage text-black text-base md:text-xl uppercase font-normal">
              {{block.settings.button_text}}
            </span>
          </a>
        </div>
      {% endif %}

    </div>
      
    {% endfor %}
  </div>
  

    
 

  

</div>


<div class="absolute inset-0 z-10 pointer-events-none top-2">
  <div class="w-full h-full relative">

      {% if section.settings.image_animation1 %}
        <img src="{{ section.settings.image_animation1 | image_url: width: section.settings.image_animation1.width, height: section.settings.image_animation1.height }}"
              width="{{ section.settings.image_animation1.width }}"
              height="{{ section.settings.image_animation1.height }}"
              class="animated-img-1 absolute md:top-[20%] top-[29%] md:left-[30%] left-[20%] w-[50px] md:w-[130px] object-cover">
      {% endif %}

      {% if section.settings.image_animation2 %}
        <img src="{{ section.settings.image_animation2 | image_url: width: section.settings.image_animation2.width, height: section.settings.image_animation2.height }}"
            width="{{ section.settings.image_animation2.width }}"
            height="{{ section.settings.image_animation2.height }}"
            class="animated-img-2 absolute md:top-[23%] top-[30%] left-[70%] w-[50px] md:w-[150px] object-cover">
      {% endif %}

      {% if section.settings.image_animation3 %}
        <img src="{{ section.settings.image_animation3 | image_url: width: section.settings.image_animation3.width, height: section.settings.image_animation3.height }}"
            width="{{ section.settings.image_animation3.width }}"
            height="{{ section.settings.image_animation3.height }}"
            class="animated-img-3 absolute bottom-[25%] md:left-[20%] left-[15%] w-[41px] md:w-[90px] object-cover">
      {% endif %}

      {% if section.settings.image_animation4 %}
        <img src="{{ section.settings.image_animation4 | image_url: width: section.settings.image_animation4.width }}" 
            width="{{ section.settings.image_animation4.width }}"
            height="{{ section.settings.image_animation4.height }}"
            class="animated-img-4 absolute bottom-[20%] left-[75%] w-[50px] md:w-[90px] object-cover">
      {% endif %}

  </div>
</div>


<style>
.hero-disclaimer-trigger {
  width: max-content;
  overflow: visible;
}

.hero-disclaimer-tooltip {
  display: block;
  position: absolute;
  top: calc(100% + 0.5rem);
  right: 0;
  width: min(18rem, calc(100vw - 2rem));
  max-width: calc(100vw - 2rem);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.hero-disclaimer-tooltip-inner {
  box-sizing: border-box;
  display: block;
  width: 100%;
  max-width: 100%;
  background: #000;
  color: #fff;
  padding: 0.5rem 0.75rem;
  border-radius: 0.5rem;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  font-size: 0.875rem;
  line-height: 1.35;
  text-align: left;
}

.hero-disclaimer-trigger:hover .hero-disclaimer-tooltip,
.hero-disclaimer-trigger:focus-within .hero-disclaimer-tooltip,
.hero-disclaimer-trigger.is-open .hero-disclaimer-tooltip {
  opacity: 1;
}

.custom-slider .slide {
  position: absolute;
  inset: 0;
}

.hero-slide {
  display: flex;
  flex-direction: column;
  background: #f7f7f7;
}

.hero-media {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
  order: 2;
}

.hero-slide-media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  transform: scale(var(--hero-zoom, 1));
  transform-origin: center var(--hero-zoom-origin, 56%);
}

.hero-copy {
  position: relative;
  z-index: 20;
  order: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  overflow: visible;
  padding: clamp(0.75rem, 3vh, 1.5rem) clamp(0.75rem, 4vw, 2rem) clamp(0.5rem, 2vh, 1rem);
  gap: clamp(0.25rem, 1vh, 0.5rem);
}

@media (min-width: 768px) {
  .hero-copy {
    padding-top: calc(var(--hero-header-h, 96px) + clamp(0.5rem, 2vh, 1.25rem));
  }
}

.hero-copy-title {
  margin: 0;
  font-weight: 700;
  font-family: 'Bricolage', serif;
  color: #000;
  line-height: 1.05;
  font-size: clamp(1.35rem, -0.1rem + 7.53vw, 3.25rem);
  display: block;
  text-align: center;
}

.hero-copy-desc {
  margin: 0;
  font-family: 'Bricolage', serif;
  color: #000;
  line-height: 1.3;
  font-size: clamp(0.68rem, 0.55rem + 1.05vw, 1.15rem);
  max-width: 100%;
  word-break: break-word;
}

.hero-cta-bottom-center {
  position: absolute;
  left: 0;
  right: 0;
  bottom: clamp(1rem, 4vh, 3.25rem);
  z-index: 30;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.hero-cta-button {
  pointer-events: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #FFCD51;
  border-radius: 1.5rem;
  padding: clamp(0.5rem, 1.4vw, 0.75rem) clamp(1.25rem, 3.2vw, 2rem);
  transition: opacity 0.2s ease;
}

.hero-cta-button:hover {
  opacity: 0.7;
}

.hero-cta-label {
  font-family: 'Bricolage', serif;
  color: #000;
  text-transform: uppercase;
  font-weight: 400;
  font-size: clamp(0.75rem, 0.6rem + 0.9vw, 1.25rem);
}

.hero-slides-wrapper {
  flex: 1 1 auto;
  height: auto;
  box-sizing: border-box;
}

@media (min-width: 768px) {
  .hero-slides-wrapper {
    flex: none;
    height: 100vh;
  }
}

.custom-slider {
  height: 100vh;
  height: 100svh;
}

@media (min-width: 768px) {
  .custom-slider {
    height: 100vh;
  }
}

@media (max-width: 767px) {
  .hero-title-logo {
    margin-left: -0.3em;
  }
}

.custom-slider .slide {
  opacity: 0;
  pointer-events: none;
}

.custom-slider .slide.active {
  opacity: 1;
  pointer-events: auto;
}


.custom-slider .slide.active {
  opacity: 1;
  z-index: 2;
}

.custom-slider .prev,
.custom-slider .next {
  z-index: 10;
}

.custom-slider .slide {
  opacity: 0;
  transform: translateY(20px);
  transition:
    opacity 0.7s ease-in-out,
    transform 0.7s ease-in-out;
  pointer-events: none;
}

.custom-slider .slide.active {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}


</style>

<script>
(function () {
  var HERO_CONTENT_BAND = 0.52; // fraction of image height the product band should fill
  var HERO_CONTENT_CENTER = 0.56; // vertical center of that band, as a fraction of natural image height
  var HERO_ZOOM_MIN = 1;
  var HERO_ZOOM_MAX = 2.2;

  function setHeroZoom() {
    document.querySelectorAll('.hero-media').forEach(function (media) {
      var mediaRect = media.getBoundingClientRect();
      if (!mediaRect.width || !mediaRect.height) return;
      var candidates = media.querySelectorAll('.hero-slide-media');
      var img = null;
      for (var i = 0; i < candidates.length; i++) {
        if (candidates[i].offsetParent !== null) { img = candidates[i]; break; }
      }
      if (!img && candidates.length) img = candidates[0];
      if (!img) return;
      var naturalW, naturalH;
      if (img.tagName === 'VIDEO') {
        naturalW = img.videoWidth;
        naturalH = img.videoHeight;
      } else {
        naturalW = img.naturalWidth;
        naturalH = img.naturalHeight;
      }
      if (!naturalW || !naturalH) return;

      var cw = mediaRect.width, ch = mediaRect.height;
      var containerAspect = cw / ch;
      var imgAspect = naturalW / naturalH;
      var visibleFraction = containerAspect >= imgAspect ? (imgAspect / containerAspect) : 1;
      var zoom = visibleFraction / HERO_CONTENT_BAND;
      zoom = Math.min(HERO_ZOOM_MAX, Math.max(HERO_ZOOM_MIN, zoom));

      // Solve the transform-origin percentage so the screen's vertical center
      // always lands on HERO_CONTENT_CENTER of the natural image, regardless
      // of zoom amount or which cover-fit regime (wide vs tall) applies.
      var originPct = HERO_CONTENT_CENTER;
      if (zoom > 1.001) {
        var coverScale = Math.max(cw / naturalW, ch / naturalH);
        var offsetY = (ch - naturalH * coverScale) / 2;
        var eyTarget = HERO_CONTENT_CENTER * naturalH * coverScale + offsetY;
        originPct = (eyTarget - 0.5 * ch / zoom) / (ch * (1 - 1 / zoom));
        originPct = Math.min(1, Math.max(0, originPct));
      }

      media.style.setProperty('--hero-zoom', zoom.toFixed(3));
      media.style.setProperty('--hero-zoom-origin', (originPct * 100).toFixed(2) + '%');
    });
  }

  function setHeroSpacer() {
    var header = document.getElementById('main-header');
    var topbar = document.querySelector('.topbar-wrapper');
    var slider = document.querySelector('.custom-slider');
    if (!header) return;
    var topbarH = topbar ? topbar.offsetHeight : 0;
    var headerH = header.offsetHeight;
    if (slider) slider.style.setProperty('--hero-header-h', (topbarH + headerH) + 'px');
    setHeroZoom();
    if (window.innerWidth >= 768) return;
    var spacer = document.getElementById('hero-header-spacer');
    if (!spacer) return;
    spacer.style.height = (topbarH + headerH) + 'px';
  }
  requestAnimationFrame(setHeroSpacer);
  document.addEventListener('DOMContentLoaded', function () { requestAnimationFrame(setHeroSpacer); });
  window.addEventListener('load', setHeroSpacer);
  window.addEventListener('resize', setHeroSpacer);
  document.querySelectorAll('.hero-slide-media').forEach(function (media) {
    if (media.tagName === 'IMG') {
      media.addEventListener('load', setHeroSpacer);
    } else if (media.tagName === 'VIDEO') {
      media.addEventListener('loadedmetadata', setHeroSpacer);
    }
  });
})();
</script>

<script>
(function () {
  function closeOtherDisclaimers(currentTrigger) {
    document.querySelectorAll('.hero-disclaimer-trigger.is-open').forEach(function (trigger) {
      if (trigger === currentTrigger) return;
      trigger.classList.remove('is-open');
      var button = trigger.querySelector('button');
      if (button) button.setAttribute('aria-expanded', 'false');
    });
  }

  document.addEventListener('click', function (event) {
    var button = event.target.closest('.hero-disclaimer-trigger button');
    if (button) {
      var trigger = button.closest('.hero-disclaimer-trigger');
      var isOpen = trigger.classList.toggle('is-open');
      button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      closeOtherDisclaimers(trigger);
      return;
    }

    if (!event.target.closest('.hero-disclaimer-trigger')) {
      closeOtherDisclaimers(null);
    }
  });

  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    closeOtherDisclaimers(null);
  });
})();
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const slider = document.querySelector(".slider-facts-{{ section.id }}");
  if (!slider) return;

  const wrapper = slider.querySelector(".slides-wrapper");
  const slides = wrapper.querySelectorAll(".slide");
  const nextBtn = slider.querySelector(".next");
  const prevBtn = slider.querySelector(".prev");

  const autoplay = slider.dataset.autoplay === "true";
  const interval = parseInt(slider.dataset.interval, 10) || 5000;

  let index = 0;
  let autoplayInterval = null;

  function showSlide(i) {
    slides.forEach(s => s.classList.remove("active"));
    slides[i].classList.add("active");
  }

  function nextSlide() {
    index = (index + 1) % slides.length;
    showSlide(index);
  }

  function prevSlide() {
    index = (index - 1 + slides.length) % slides.length;
    showSlide(index);
  }

  function startAutoplay() {
    stopAutoplay();
    if (!autoplay) return;

    autoplayInterval = setInterval(() => {
      nextSlide();
    }, interval);
  }

  function stopAutoplay() {
    if (autoplayInterval) {
      clearInterval(autoplayInterval);
      autoplayInterval = null;
    }
  }

  nextBtn.addEventListener("click", () => {
    nextSlide();
    startAutoplay();
  });

  prevBtn.addEventListener("click", () => {
    prevSlide();
    startAutoplay();
  });

  startAutoplay();
});
</script>



