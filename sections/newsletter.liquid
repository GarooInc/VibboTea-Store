{% unless template == 'page.newsletter' %}

<style>
  /* Subtítulo Klaviyo más grande */
  .newsletter-section .klaviyo-form-UcYx3V p,
  .newsletter-section .klaviyo-form-UcYx3V div[data-testid="form-component"] p,
  .newsletter-section .klaviyo-form-UcYx3V span,
  .newsletter-section .klaviyo-form-UcYx3V div[class*="text"],
  .newsletter-section .klaviyo-form-UcYx3V div[class*="paragraph"] {
    font-size: 17px !important;
    font-weight: 500 !important;
    line-height: 1.5 !important;
  }

  /* Compactar padding interno y gaps del form (Klaviyo pinta padding inline) */
  .newsletter-section .klaviyo-form-UcYx3V form,
  .newsletter-section .klaviyo-form-UcYx3V form > div,
  .newsletter-section .klaviyo-form-UcYx3V [data-testid="klaviyo-form"] {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    row-gap: 0.5rem !important;
    gap: 0.5rem !important;
  }

  .newsletter-section .klaviyo-form-UcYx3V [data-testid="form-component"],
  .newsletter-section .klaviyo-form-UcYx3V [data-testid="form-row"] {
    margin-top: 0 !important;
    margin-bottom: 0.5rem !important;
  }

  .newsletter-section .klaviyo-form-UcYx3V [data-testid="form-component"]:last-child,
  .newsletter-section .klaviyo-form-UcYx3V [data-testid="form-row"]:last-child {
    margin-bottom: 0 !important;
  }
</style>

<div
  class="newsletter-section w-screen bg-[#EBEBEB] overflow-hidden"
  style="width: 100vw; margin-left: calc(50% - 50vw);"
>
  <!-- Grid: latas izquierda (solo desktop) + título + form derecha -->
  <div class="md:grid md:grid-cols-[3fr_4fr] md:items-center flex flex-col">

    <!-- Imagen: solo desktop -->
    <div class="hidden md:flex justify-center items-center">
      <img
        src="{{ section.settings.imagen | image_url: width: 600 }}"
        alt="Imagen"
        class="w-[30vw] max-w-md max-h-[320px] object-contain block"
        width="{{ section.settings.background_image.width }}"
        height="{{ section.settings.background_image.height }}"
      >
    </div>

    <!-- Título + Klaviyo form -->
    <div class="flex flex-col px-6 md:px-10 pt-3 pb-3 md:pb-4">
      <h2 class="hidden md:block text-5xl font-bold font-bricolage text-center leading-tight mb-2">
        {{ section.settings.title }}
      </h2>
      <h2 class="md:hidden text-3xl font-bold font-bricolage text-center leading-tight mb-2">
        {{ section.settings.title_mobile }}
      </h2>
      <div class="klaviyo-form-UcYx3V"></div>
    </div>

  </div>
</div>

{% endunless %}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "image_picker",
      "id": "imagen",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Join the tribe"
    },
    {
      "type": "textarea",
      "id": "texto1",
      "label": "Texto 1",
      "default": "Sign Up to our newsletter and be the first to know about our launch and exclusive offers"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "email address"
    },
    {
      "type": "text",
      "id": "title_mobile",
      "label": "Title Mobile",
      "default": "You know you want to"
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
    }
  ]
}
{% endschema %}
