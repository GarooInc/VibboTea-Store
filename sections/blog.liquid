{% comment %}
  Blog index listing: tag filters, article grid, and pagination.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

{% liquid
  assign excluded = ','
  assign heading = section.settings.heading

  unless current_tags
    if section.settings.exclude_article_1 != blank
      assign excluded = excluded | append: section.settings.exclude_article_1.handle | append: ','
    elsif section.settings.skip_latest_article and blog.articles.first != blank
      assign excluded = excluded | append: blog.articles.first.handle | append: ','
    endif

    if section.settings.exclude_article_2 != blank
      assign excluded = excluded | append: section.settings.exclude_article_2.handle | append: ','
    endif

    if section.settings.exclude_article_3 != blank
      assign excluded = excluded | append: section.settings.exclude_article_3.handle | append: ','
    endif

    if section.settings.exclude_article_4 != blank
      assign excluded = excluded | append: section.settings.exclude_article_4.handle | append: ','
    endif
  endunless
%}

{% paginate blog.articles by section.settings.articles_per_page %}
  {% liquid
    assign shown_count = 0
    for article in blog.articles
      assign handle_token = ',' | append: article.handle | append: ','
      unless excluded contains handle_token
        assign shown_count = shown_count | plus: 1
      endunless
    endfor
  %}

  {% if shown_count > 0 or current_tags %}
    <div class="blog-listing" {{ section.shopify_attributes }}>
      {% if heading != blank %}
        <h2 class="blog-listing__heading font-bricolage">{{ heading | escape }}</h2>
      {% endif %}

      {%- comment -%}
        Con "switcher_tag" (p. ej. "How to") el menu de etiquetas se cambia por
        dos botones como los de tamaño del producto: los posts con esa etiqueta
        van en el segundo boton y todo lo demas en el primero (Vi-Blog).
      {%- endcomment -%}
      {% assign switcher_tag = section.settings.switcher_tag | strip %}
      {% if switcher_tag != blank and current_tags == blank %}
        <div class="blog-switcher" role="tablist" aria-label="{{ 'blog.tag_filter_label' | t }}">
          <button type="button" role="tab" class="blog-switcher__option font-bricolage is-active" aria-selected="true" data-blog-group="main">
            {{ section.settings.switcher_main_label | escape }}
          </button>
          <button type="button" role="tab" class="blog-switcher__option font-bricolage" aria-selected="false" data-blog-group="tagged">
            {{ switcher_tag | escape }}
          </button>
        </div>
      {% elsif blog.all_tags.size > 0 %}
        <nav class="blog-listing__tags" aria-label="{{ 'blog.tag_filter_label' | t }}">
          <a
            href="{{ blog.url }}"
            class="blog-listing__tag font-bricolage{% unless current_tags %} is-active{% endunless %}"
            {% unless current_tags %}aria-current="page"{% endunless %}
          >
            {{ 'blog.all' | t }}
          </a>

          {% for tag in blog.all_tags %}
            <a
              href="{{ blog.url }}/tagged/{{ tag | handleize }}"
              class="blog-listing__tag font-bricolage{% if current_tags contains tag %} is-active{% endif %}"
              {% if current_tags contains tag %}aria-current="page"{% endif %}
            >
              {{ tag | escape }}
            </a>
          {% endfor %}
        </nav>
      {% endif %}

      {% if shown_count > 0 %}
        <div class="blog-listing__grid">
          {% for article in blog.articles %}
            {% assign handle_token = ',' | append: article.handle | append: ',' %}
            {% unless excluded contains handle_token %}
              {%- liquid
                assign article_group = 'main'
                if switcher_tag != blank and article.tags contains switcher_tag
                  assign article_group = 'tagged'
                endif
              -%}
              <div
                class="blog-listing__item"
                data-blog-item="{{ article_group }}"
                {% if switcher_tag != blank and current_tags == blank and article_group == 'tagged' %}hidden{% endif %}
              >
                {% render 'article-card', article: article, loading: 'lazy' %}
              </div>
            {% endunless %}
          {% endfor %}
        </div>

        {% if switcher_tag != blank and current_tags == blank %}
          <script>
            (function () {
              var root = document.currentScript.closest('.blog-listing');
              var options = root.querySelectorAll('[data-blog-group]');
              var items = root.querySelectorAll('[data-blog-item]');
              options.forEach(function (option) {
                option.addEventListener('click', function () {
                  var group = option.dataset.blogGroup;
                  options.forEach(function (o) {
                    var active = o === option;
                    o.classList.toggle('is-active', active);
                    o.setAttribute('aria-selected', active ? 'true' : 'false');
                  });
                  items.forEach(function (item) {
                    item.hidden = item.dataset.blogItem !== group;
                  });
                });
              });
            })();
          </script>
        {% endif %}
      {% endif %}

      {% if shown_count == 0 %}
        <p class="blog-listing__empty font-bricolage">{{ 'blog.no_articles' | t }}</p>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="blog-listing__pagination" aria-label="{{ 'blog.pagination_label' | t }}">
          {% if paginate.previous %}
            <a class="blog-listing__page-link font-bricolage" href="{{ paginate.previous.url }}">
              {{ 'blog.pagination_previous' | t }}
            </a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a class="blog-listing__page-link font-bricolage" href="{{ part.url }}">{{ part.title }}</a>
            {% elsif part.title == paginate.current_page %}
              <span class="blog-listing__page-link is-current font-bricolage" aria-current="page">{{ part.title }}</span>
            {% else %}
              <span class="blog-listing__page-ellipsis">{{ part.title }}</span>
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a class="blog-listing__page-link font-bricolage" href="{{ paginate.next.url }}">
              {{ 'blog.pagination_next' | t }}
            </a>
          {% endif %}
        </nav>
      {% endif %}
    </div>
  {% endif %}
{% endpaginate %}

{% stylesheet %}
  .blog-listing {
    padding: 1rem 0 4.5rem;
  }

  .blog-listing__heading {
    margin: 0 0 1.25rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    color: #000;
  }

  .blog-listing__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-bottom: 2rem;
  }

  .blog-listing__tag {
    font-size: 1rem;
    font-weight: 500;
    color: #000;
    text-decoration: none;
    padding-bottom: 0.15rem;
    border-bottom: 2px solid transparent;
  }

  .blog-listing__tag:hover,
  .blog-listing__tag:focus-visible {
    opacity: 0.7;
  }

  .blog-listing__tag.is-active {
    font-weight: 700;
    border-bottom-color: #000;
  }

  .blog-listing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 1.5rem;
  }

  .blog-listing__item[hidden] {
    display: none;
  }

  /* Pastillas como los botones del sitio (Add to cart, menu): redondas,
     en mayusculas; la elegida va rellena en negro. Alineadas con el titulo. */
  .blog-switcher {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .blog-switcher__option {
    padding: 0.7rem 1.75rem;
    border: 1.5px solid #000;
    border-radius: 999px;
    background-color: transparent;
    color: #000;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .blog-switcher__option:hover {
    background-color: rgba(0, 0, 0, 0.06);
  }

  .blog-switcher__option.is-active {
    background-color: #000;
    color: #fff;
  }

  .blog-listing__empty {
    margin: 0;
    font-size: 1rem;
    color: #666;
  }

  .blog-listing__pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
    margin-top: 3rem;
  }

  .blog-listing__page-link {
    display: inline-flex;
    min-width: 2rem;
    justify-content: center;
    color: #000;
    text-decoration: none;
    font-size: 1rem;
  }

  .blog-listing__page-link:hover,
  .blog-listing__page-link:focus-visible {
    text-decoration: underline;
  }

  .blog-listing__page-link.is-current {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .blog-listing__page-ellipsis {
    color: #666;
  }

  @media (min-width: 768px) {
    .blog-listing__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .blog-listing {
      padding-bottom: 5.5rem;
    }

    .blog-listing__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "tag": "section",
  "class": "blog-listing-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.more_articles_heading",
      "default": "More Articles"
    },
    {
      "type": "text",
      "id": "switcher_tag",
      "label": "Second button tag",
      "info": "Etiqueta de los posts que van en el segundo boton (p. ej. How to). Vacio = menu de etiquetas normal."
    },
    {
      "type": "text",
      "id": "switcher_main_label",
      "label": "First button label",
      "default": "Vi-Blog"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "t:labels.articles_per_page",
      "min": 6,
      "max": 18,
      "step": 3,
      "default": 12
    },
    {
      "type": "header",
      "content": "t:labels.exclude_from_listing"
    },
    {
      "type": "checkbox",
      "id": "skip_latest_article",
      "label": "t:labels.skip_latest_article",
      "info": "t:info.skip_latest_article",
      "default": true
    },
    {
      "type": "article",
      "id": "exclude_article_1",
      "label": "t:labels.exclude_article",
      "info": "t:info.exclude_featured_article"
    },
    {
      "type": "article",
      "id": "exclude_article_2",
      "label": "t:labels.exclude_article"
    },
    {
      "type": "article",
      "id": "exclude_article_3",
      "label": "t:labels.exclude_article"
    },
    {
      "type": "article",
      "id": "exclude_article_4",
      "label": "t:labels.exclude_article"
    }
  ]
}
{% endschema %}
