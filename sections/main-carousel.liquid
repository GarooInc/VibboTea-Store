<!-- TÍTULO -->
    <div class="text-center items-center align-center pt-10 ">
        <h2 class="md:text-5xl text-3xl text-black font-normal font-bricolage ">
            {{ section.settings.section_title | default: "Join the trive" | newline_to_br}}
        </h2>
            <p class="text-black text-[3.5vw] md:text-xl font-bricolage mr-2 md:px-30 py-5 pb-10">
                    {{ section.settings.section_desc }}
                </p>

         {% if section.settings.redireccionamiento %}   
          <div class="bg-[#FFCD51] h-12 inline-flex items-center justify-between rounded-full border border-black pl-4 ">

            <p class="text-black text-[3.5vw] md:text-xl font-bricolage flex-1 text-left px-2">
              {{ section.settings.text_button }}
            </p>

            <a href="/collections/frontpage"
              class="hover:opacity-70 transition-opacity scale-75 md:scale-95 pr-1"
              aria-label="Ir a la colección principal">
              {%- render 'arrow' -%}
            </a>
          </div>
        {% endif %}
    </div>

    {% if section.settings.collection != blank %}
      {% assign coll = collections[section.settings.collection] %}
    {% else %}
      {% assign coll = collection %}
    {% endif %}

    {% assign products_count = section.settings.limit | default: coll.products_count %}
    

<section
  class="relative w-full  pt-4"
  aria-roledescription="carousel"
>
  <!-- Desktop: 3 imágenes visibles -->
  <div class="hidden md:block relative overflow-hidden py-8 " data-snap-slider>
    <div class="snap-track flex" data-snap-track
      style="--snap-card-md: 33.333%; --snap-align: start; --snap-pad: 0;">
      {% if coll %}
        {% for product in coll.products limit: section.settings.limit %}
          {% assign product_image_class = 'absolute inset-0 w-full h-full object-cover object-center' %}
          {% assign product_image_style = '' %}
          {% if product.handle == 'assorted-reset-bundle-set' %}
            {% assign product_image_style = 'object-position: center 38%;' %}
          {% endif %}

          <div class="snap-start shrink-0 w-full md:w-[33%] px-4">
            <a href="{{ product.url }}" class="block w-full">
              {% liquid
                assign primary_media = product.media[0] | default: product.featured_media
                assign hover_media = nil
                if product.media.size > 1
                  assign hover_media = product.media[1]
                endif
              %}
              <div class="relative w-full aspect-square bg-white rounded-2xl overflow-hidden group">
                {%- assign has_sold_out_tag = false -%}
                {%- if product.tags contains 'Sold Out' -%}
                  {%- assign has_sold_out_tag = true -%}
                {%- endif -%}
                {%- assign negative_stock = true -%}
                {%- for variant in product.variants -%}
                  {%- if variant.inventory_management == blank -%}
                    {%- assign negative_stock = false -%}
                    {%- break -%}
                  {%- elsif variant.inventory_quantity > 0 -%}
                    {%- assign negative_stock = false -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if has_sold_out_tag or negative_stock -%}
                  <div class="absolute top-[22px] left-3 z-10 text-black text-sm md:text-base font-bricolage uppercase px-4 py-1.5 rounded-full" style="background-color: #fab801;">
                    Sold Out
                  </div>
                {%- endif -%}
                {%- if product.tags contains 'NEW' -%}
                  <div class="absolute top-[22px] right-3 z-10 text-white text-sm md:text-base font-bricolage uppercase px-4 py-1.5 rounded-full bg-black">
                    New
                  </div>
                {%- endif -%}
                {% if primary_media %}
                  <img
                    src="{{ primary_media | image_url: width: 800 }}"
                    alt="{{ primary_media.alt | escape }}"
                    width="{{ primary_media.width }}"
                    height="{{ primary_media.height }}"
                    loading="lazy"
                    class="{{ product_image_class }}{% if hover_media %} transition-opacity duration-350 group-hover:opacity-0{% else %} hover:scale-105 transition-transform duration-350{% endif %}"
                    {% if product_image_style != '' %}style="{{ product_image_style }}"{% endif %}
                  >
                {% endif %}
                {% if hover_media %}
                  <img
                    src="{{ hover_media | image_url: width: 800 }}"
                    alt="{{ hover_media.alt | escape }}"
                    width="{{ hover_media.width }}"
                    height="{{ hover_media.height }}"
                    loading="lazy"
                    class="{{ product_image_class }} opacity-0 transition-opacity duration-350 group-hover:opacity-100"
                    {% if product_image_style != '' %}style="{{ product_image_style }}"{% endif %}
                  >
                {% endif %}
              </div>

              

              <div class="mt-4">
                <p class="font-bricolage text-2xl md:text-[1.1vw] text-left text-[#575757] font-medium pt-4">
                  {{ product.title }}
                </p>
                {% render 'product-carousel-reviews', product: product %}
                <p class="font-bricolage text-2xl md:text-3xl  md:pt-1 text-left text-black font-medium">
                  {{ product.price | money }}
                </p>
              </div>
            </a>

            <form method="post" action="{{ routes.cart_add_url }}" class="md:pt-5 md:text-center mx-auto">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

              <button 
                type="submit" 
                class="md:bg-black flex items-center justify-center w-full rounded-3xl py-3 md:mt-4 
                      hover:opacity-70 transition-opacity cursor-pointer"
              >
                <span class="font-bricolage md:text-[0.9vw]
                   text-white text-xl uppercase font-light md:text-center">
                   {{section.settings.text_button_add}}
                </span>
              </button>
            </form>

          </div>
        {% endfor %}
      {% endif %}

    </div>

    <!-- Flechas Desktop -->
    <div class="flex items-center justify-between absolute inset-0 px-6 pointer-events-none">
      <button type="button" data-snap-prev aria-label="Previous products" class="-translate-x-5 scale-120 pointer-events-auto hover:opacity-70 transition-opacity">
        {% render 'arrow-slidder2' %}
      </button>

      
      

      <button type="button" data-snap-next aria-label="Next products" class="translate-x-5 scale-120 pointer-events-auto hover:opacity-70 transition-opacity">
        {% render 'arrow-slidder' %}
      </button>
    </div>

  </div>

 <!-- Mobile: 1 imagen visible -->
<div class="md:hidden relative " data-snap-slider>
  <!-- Contenedor del carrusel -->
  <div class="relative overflow-hidden" style="padding-bottom: 40px;">
      <div class="snap-track flex" data-snap-track
       style="--snap-card: 100%; --snap-align: start; --snap-pad: 0;">
      {% if coll %}
