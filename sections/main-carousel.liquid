                    {% if product_image_style != '' %}style="{{ product_image_style }}"{% endif %}
                  >
                {% endif %}
                {% if hover_media %}
                  <img
                    src="{{ hover_media | image_url: width: 800 }}"
                    alt="{{ hover_media.alt | escape }}"
                    width="{{ hover_media.width }}"
                    height="{{ hover_media.height }}"
                    loading="lazy"
                    class="{{ product_image_class }} opacity-0 transition-opacity duration-350 group-hover:opacity-100"
                    {% if product_image_style != '' %}style="{{ product_image_style }}"{% endif %}
                  >
                {% endif %}
              </div>

              <div class="mt-4">
                <p class="font-bricolage text-lg md:text-[1.1vw] text-left text-[#575757] font-medium pt-4">{{ product.title }}</p>
                {% render 'product-carousel-reviews', product: product %}
                <p class="font-bricolage text-3xl text-left text-black font-medium">{{ product.price | money }}</p>
              </div>

            </a>
            <form method="post" action="/cart/add" class="w-full pt-5 px-4 text-center mx-auto ">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="bg-black flex items-center justify-center w-full
                 rounded-3xl py-3 md:mt-4 ">
                <span class="font-bricolage text-white text-sm uppercase font-light text-center">{{section.settings.text_button_add}}</span>
              </button>
            </form>
          </div>
        {% endfor %}
      {% endif %}
        </div>
      </div>



  <!-- Flechas Mobile: centradas sobre la foto cuadrada (ancho de pantalla menos px-4) -->
  <div class="absolute inset-x-0 top-0 flex items-center justify-between pointer-events-none" style="height: calc(100vw - 2rem);">
    <button type="button" data-snap-prev aria-label="Previous product" class="pointer-events-auto">
      {% render 'arrow-slidder2' %}
    </button>

    <button type="button" data-snap-next aria-label="Next product" class="pointer-events-auto">
      {% render 'arrow-slidder' %}
    </button>
  </div>

</div>

  
</section>


{% render 'snap-slider' %}


{% schema %}
{
  "name": "Slider Productos",
  "settings": [
     {
      "type": "textarea",
      "id": "section_title",
      "label": "Title",
      "default": "Productos Destacados"
    },
    {
      "type": "textarea",
      "id": "section_desc",
      "label": "Descripcion",
      "default": "Productos Destacados"
    },
    {
      "type": "textarea",
      "id": "text_button",
      "label": "Texto de redireccionamiento",
      "default": "I want to feel human again"
    },

    {
      "type": "textarea",
      "id": "text_button_add",
      "label": "Texto de boton",
      "default": "SHOP ALL PRODUCTS"
    },
    {
      "type": "checkbox",
      "id": "redireccionamiento",
      "label": "Redireccionamiento",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "number",
      "id": "limit",
      "label": "Número máximo de productos",
      "default": 12
    }
  ],
  
  "presets": [
    {
      "name": "Carousel de productos", 
        "category": "Productos"

    }
  ]
}
{% endschema %}