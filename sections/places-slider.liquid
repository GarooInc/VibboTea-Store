<div class="custom-slider-places relative w-screen mx-auto"
style="margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);">
  <div class="slides-wrapper relative w-full">
    {% for block in section.blocks %}
      {% assign map_img = block.settings.map_image %}
      {% assign bg_color = block.settings.background_color | default: '#ffffff' %}
      <div class="slide absolute inset-0 {% if forloop.first %}active first-slide{% endif %}" style="background-color: {{ bg_color }};">

        <div class="slide-content relative w-full h-full flex {% if forloop.first %}first-slide-content{% endif %}">

          <img
            src="{{ map_img | img_url: '2000x2000' }}"
            class="places-map object-contain {% if forloop.first %}first-slide-map{% endif %}"
            width="{{ map_img.width }}"
            height="{{ map_img.height }}"
            alt="{{ block.settings.map_alt | escape }}"
          />

          <div class="places-headline tracking-normal text-left richnameplace font-bricolage">
            {{ block.settings.richtext }}
          </div>

          <div class="places-ingredients-panel">
            <div class="places-ingredients-inner">
              {% if block.settings.place_title != blank %}
                <div class="places-place-title text-left">
                  {{ block.settings.place_title }}
                </div>
              {% endif %}

              <div class="places-ingredients-list">
                {% if block.settings.ingredient_1_name != blank or block.settings.ingredient_1_image != blank %}
                  <div class="places-ingredient flex items-center justify-start gap-3">
                    {% if block.settings.ingredient_1_image != blank %}
                      <img
                        src="{{ block.settings.ingredient_1_image | img_url: '100x100' }}"
                        alt="{{ block.settings.ingredient_1_name | escape }}"
                        class="places-ingredient-img object-contain"
                        width="56"
                        height="56"
                      />
                    {% endif %}
                    {% if block.settings.ingredient_1_name != blank %}
                      <span class="places-ingredient-name">{{ block.settings.ingredient_1_name }}</span>
                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.ingredient_2_name != blank or block.settings.ingredient_2_image != blank %}
                  <div class="places-ingredient flex items-center justify-start gap-3">
                    {% if block.settings.ingredient_2_image != blank %}
                      <img
                        src="{{ block.settings.ingredient_2_image | img_url: '100x100' }}"
                        alt="{{ block.settings.ingredient_2_name | escape }}"
                        class="places-ingredient-img object-contain"
                        width="56"
                        height="56"
                      />
                    {% endif %}
                    {% if block.settings.ingredient_2_name != blank %}
                      <span class="places-ingredient-name">{{ block.settings.ingredient_2_name }}</span>
                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.ingredient_3_name != blank or block.settings.ingredient_3_image != blank %}
                  <div class="places-ingredient flex items-center justify-start gap-3">
                    {% if block.settings.ingredient_3_image != blank %}
                      <img
                        src="{{ block.settings.ingredient_3_image | img_url: '100x100' }}"
                        alt="{{ block.settings.ingredient_3_name | escape }}"
                        class="places-ingredient-img object-contain"
                        width="56"
                        height="56"
                      />
                    {% endif %}
                    {% if block.settings.ingredient_3_name != blank %}
                      <span class="places-ingredient-name">{{ block.settings.ingredient_3_name }}</span>
                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.ingredient_4_name != blank or block.settings.ingredient_4_image != blank %}
                  <div class="places-ingredient flex items-center justify-start gap-3">
                    {% if block.settings.ingredient_4_image != blank %}
                      <img
                        src="{{ block.settings.ingredient_4_image | img_url: '100x100' }}"
                        alt="{{ block.settings.ingredient_4_name | escape }}"
                        class="places-ingredient-img object-contain"
                        width="56"
                        height="56"
                      />
                    {% endif %}
                    {% if block.settings.ingredient_4_name != blank %}
                      <span class="places-ingredient-name">{{ block.settings.ingredient_4_name }}</span>
                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.ingredient_5_name != blank or block.settings.ingredient_5_image != blank %}
                  <div class="places-ingredient flex items-center justify-start gap-3">
                    {% if block.settings.ingredient_5_image != blank %}
                      <img
                        src="{{ block.settings.ingredient_5_image | img_url: '100x100' }}"
                        alt="{{ block.settings.ingredient_5_name | escape }}"
                        class="places-ingredient-img object-contain"
                        width="56"
                        height="56"
                      />
                    {% endif %}
                    {% if block.settings.ingredient_5_name != blank %}
                      <span class="places-ingredient-name">{{ block.settings.ingredient_5_name }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="places-slider-nav absolute grid grid-cols-2 md:bottom-5 md:right-5 bottom-3 right-2">
    <button type="button" class="prev text-white py-2 opacity-100 hover:opacity-60 transition duration-300" aria-label="Previous slide">
      <div class="w-10 h-10 md:w-30 md:h-30 justify-center md:pl-15">
        {%- render 'arrow-slidder2' -%}
      </div>
    </button>

    <button type="button" class="next text-white py-2 opacity-100 hover:opacity-60 transition duration-300" aria-label="Next slide">
      <div class="w-10 h-10 md:w-30 md:h-30">
        {%- render 'arrow-slidder' -%}
      </div>
    </button>
  </div>
</div>

<style>
.custom-slider-places {
  position: relative;
  height: auto;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: visible;
}

.custom-slider-places .slides-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
}

.custom-slider-places .slide {
  position: absolute;
  inset: 0;
  width: 100%;
  height: auto;
  min-height: 100%;
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.custom-slider-places .slide.active {
  position: relative;
  opacity: 1;
  pointer-events: auto;
}

.custom-slider-places .slide img {
  display: block;
}

.custom-slider-places .slide-content {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
}

.custom-slider-places .places-map {
  max-width: 1000px;
  height: auto;
}

.custom-slider-places .places-headline {
  font-size: 1rem;
}

.custom-slider-places .places-place-title {
  font-size: 1.5rem;
  font-weight: 700;
}

.custom-slider-places .places-ingredient-img {
  width: 2.5rem;
  height: 2.5rem;
  flex: 0 0 auto;
}

.custom-slider-places .places-ingredient-name {
  font-size: 0.875rem;
  line-height: 1.2;
  text-align: left;
}

.custom-slider-places .places-slider-nav {
  z-index: 5;
}

/* Mobile: stack headline -> map -> ingredients */
@media (max-width: 767px) {
  .custom-slider-places .slide-content {
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    padding-top: 4.75rem;
    padding-bottom: 3.5rem;
    height: auto;
  }

  .custom-slider-places .places-headline {
    position: static;
    order: 1;
    flex-shrink: 0;
    max-width: none;
    width: 100%;
    padding-left: max(1.25rem, env(safe-area-inset-left));
    padding-right: max(1.25rem, env(safe-area-inset-right));
    padding-bottom: 0.75rem;
    font-size: 1rem;
  }

  .custom-slider-places .places-map {
    order: 2;
    width: min(calc(100% - 2rem), 340px);
    max-width: 340px;
    height: auto;
    max-height: none;
    margin: 0.75rem auto;
    object-fit: contain;
  }

  .custom-slider-places .places-ingredients-panel {
    order: 3;
    position: static;
    width: 100%;
    padding-left: max(1.25rem, env(safe-area-inset-left));
    padding-right: max(1.25rem, env(safe-area-inset-right));
    padding-bottom: 0.5rem;
  }

  .custom-slider-places .places-ingredients-inner {
    width: 100%;
  }

  .custom-slider-places .places-place-title {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .custom-slider-places .places-ingredients-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: minmax(2rem, auto);
    gap: 0.65rem 0.75rem;
    height: auto;
    min-height: 0;
  }

  .custom-slider-places .places-ingredient {
    gap: 0.45rem;
    min-width: 0;
  }

  .custom-slider-places .places-ingredient-img {
    width: 2rem;
    height: 2rem;
  }

  .custom-slider-places .places-ingredient-name {
    font-size: 0.72rem;
    line-height: 1.1;
  }

  /* Intro slide: no ingredients panel */
  .custom-slider-places .slide.first-slide .places-ingredients-panel {
    display: none;
  }

  .custom-slider-places .slide.first-slide .slide-content {
    padding-bottom: 3.5rem;
  }
}

/* Desktop: map + absolute overlays */
@media (min-width: 768px) {
  .custom-slider-places {
    height: min(720px, 85vh);
    min-height: 540px;
    overflow: hidden;
  }

  .custom-slider-places .slide {
    height: 100%;
  }

  .custom-slider-places .slide-content {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 0;
    padding-bottom: 0;
  }

  .custom-slider-places .places-map {
    height: 100%;
    max-height: 100%;
    max-width: 46vw;
    width: auto;
    margin: 0 auto;
  }

  .custom-slider-places .slide.first-slide .slide-content {
    justify-content: flex-end;
  }

  .custom-slider-places .slide.first-slide .first-slide-map {
    max-width: 60vw;
    margin-left: auto;
    margin-right: 5vw;
  }

  .custom-slider-places .places-headline {
    position: absolute;
    top: 5rem;
    left: 5rem;
    z-index: 2;
    max-width: 48rem;
    font-size: 1.5rem;
  }

  .custom-slider-places .places-ingredients-panel {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 4rem;
    pointer-events: none;
  }

  .custom-slider-places .places-ingredients-inner {
    pointer-events: auto;
    text-align: right;
  }

  .custom-slider-places .places-place-title {
    font-size: 2.25rem;
    margin-bottom: 2rem;
  }

  .custom-slider-places .places-ingredients-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: auto;
    max-height: 20rem;
    padding-top: 1rem;
    padding-left: 1.5rem;
  }

  .custom-slider-places .places-ingredient-img {
    width: 3.5rem;
    height: 3.5rem;
  }

  .custom-slider-places .places-ingredient-name {
    font-size: 1rem;
  }

  .custom-slider-places .richnameplace p:first-child {
    line-height: 1.5;
    margin-bottom: 0;
  }

  .custom-slider-places .slide.first-slide .places-ingredients-panel {
    display: none;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const slider = document.querySelector(".custom-slider-places");
  if (!slider) return;

  const wrapper = slider.querySelector(".slides-wrapper");
  const slides = slider.querySelectorAll(".slide");
  const nextBtn = slider.querySelector(".next");
  const prevBtn = slider.querySelector(".prev");

  let index = 0;

  function syncWrapperHeight() {
    if (!wrapper || window.matchMedia("(min-width: 768px)").matches) {
      if (wrapper) wrapper.style.height = "";
      return;
    }
    const active = slides[index];
    if (!active) return;
    wrapper.style.height = active.offsetHeight + "px";
  }

  function showSlide(i) {
    slides.forEach(function (s) {
      s.classList.remove("active");
      s.style.position = "absolute";
    });
    slides[i].classList.add("active");
    slides[i].style.position = "relative";
    requestAnimationFrame(syncWrapperHeight);
  }

  nextBtn.addEventListener("click", function () {
    index = (index + 1) % slides.length;
    showSlide(index);
  });

  prevBtn.addEventListener("click", function () {
    index = (index - 1 + slides.length) % slides.length;
    showSlide(index);
  });

  window.addEventListener("resize", syncWrapperHeight);

  if (typeof ResizeObserver !== "undefined") {
    const ro = new ResizeObserver(syncWrapperHeight);
    slides.forEach(function (s) {
      ro.observe(s);
    });
  }

  syncWrapperHeight();
});
</script>

