{% comment %}
  Article page: blog post with reading layout below the fixed header.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

{% liquid
  assign date = article.published_at | time_tag: format: 'date'
  assign image_alt = article.title
  if article.image
    assign image_alt = article.image.alt | default: article.title
  endif
%}

<article class="article-page" {{ section.shopify_attributes }}>
  <header class="article-page__header">
    <a class="article-page__back font-bricolage" href="{{ blog.url }}">
      {{ 'blog.back_to_blog' | t }}
    </a>

    {% if article.tags.size > 0 %}
      <ul class="article-page__tags">
        {% for tag in article.tags %}
          <li>
            <a class="article-page__tag font-bricolage" href="{{ blog.url }}/tagged/{{ tag | handleize }}">
              {{ tag | escape }}
            </a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    <h1 class="article-page__title font-bricolage">{{ article.title | escape }}</h1>

    <p class="article-page__byline">
      {{ 'blog.article_metadata_html' | t: date: date, author: article.author }}
    </p>
  </header>

  {% if article.image %}
    <div class="article-page__media">
      {{ article.image
        | image_url: width: 1600
        | image_tag:
          loading: 'eager',
          widths: '600, 900, 1200, 1600',
          sizes: '100vw',
          alt: image_alt,
          class: 'article-page__image'
      }}
    </div>
  {% endif %}

  <div class="article-page__content">
    {{ article.content }}
  </div>

  {% if blog.comments_enabled? %}
    <section class="article-page__comments" id="comments" aria-labelledby="article-comments-heading">
      <h2 id="article-comments-heading" class="article-page__comments-title font-bricolage">
        {{ 'blog.article_comments' | t }}
      </h2>

      {% paginate article.comments by 10 %}
        {% if article.comments_count > 0 %}
          <ol class="article-page__comment-list">
            {% for comment in article.comments %}
              <li class="article-page__comment">
                <p class="article-page__comment-meta">
                  <span class="font-bricolage">{{ comment.author | escape }}</span>
                  {{ comment.created_at | time_tag: format: 'date' }}
                </p>
                <div class="article-page__comment-body">{{ comment.content }}</div>
              </li>
            {% endfor %}
          </ol>
        {% endif %}

        {% if paginate.pages > 1 %}
          {{ paginate | default_pagination: anchor: 'comments' }}
        {% endif %}
      {% endpaginate %}

      {% form 'new_comment', article %}
        <h2 class="article-page__comments-title font-bricolage">{{ 'blog.comment_form_title' | t }}</h2>

        {{ form.errors | default_errors }}

        <div class="article-page__field">
          <label for="CommentFormAuthor">{{ 'blog.comment_form_name' | t }}</label>
          <input
            type="text"
            name="comment[author]"
            id="CommentFormAuthor"
            value="{{ form.author }}"
            required
            autocomplete="name"
          >
        </div>

        <div class="article-page__field">
          <label for="CommentFormEmail">{{ 'blog.comment_form_email' | t }}</label>
          <input
            type="email"
            name="comment[email]"
            id="CommentFormEmail"
            value="{{ form.email }}"
            required
            autocomplete="email"
          >
        </div>

        <div class="article-page__field">
          <label for="CommentFormBody">{{ 'blog.comment_form_body' | t }}</label>
          <textarea name="comment[body]" id="CommentFormBody" rows="5" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="article-page__submit font-bricolage">
          {{ 'blog.comment_form_submit' | t }}
        </button>
      {% endform %}
    </section>
  {% endif %}
</article>

{% style %}
  .article-page-section {
    padding-bottom: 4.5rem;
  }
  @media (min-width: 768px) {
    .article-page-section {
      padding-bottom: 5.5rem;
    }
  }
{% endstyle %}

{% stylesheet %}
  .article-page {
    padding: 1.5rem 0 0;
  }

  .article-page__header {
    max-width: 42rem;
    margin: 0 auto 2.5rem;
  }

  .article-page__back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #000;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .article-page__back:hover,
  .article-page__back:focus-visible {
    opacity: 0.7;
  }

  .article-page__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .article-page__tag {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border: 1px solid #000;
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: capitalize;
    color: #000;
    text-decoration: none;
  }

  .article-page__tag:hover,
  .article-page__tag:focus-visible {
    background-color: #000;
    color: #fff;
  }

  .article-page__title {
    margin: 0;
    font-size: clamp(1.85rem, 4.5vw, 2.85rem);
    font-weight: 600;
    line-height: 1.15;
    color: #000;
  }

  .article-page__byline {
    margin: 1rem 0 0;
    font-size: 0.95rem;
    color: #555;
  }

  .article-page__media {
    overflow: hidden;
    margin: 0 auto 2.5rem;
    border-radius: 1.25rem;
    background-color: #f3f3f3;
  }

  .article-page__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .article-page__content {
    font-size: 1.125rem;
    line-height: 1.75;
    color: #222;
  }

  .article-page__content > * {
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  .article-page__content > div:first-child,
  .article-page__content > iframe,
  .article-page__content > table {
    width: 100%;
    max-width: 100%;
    margin-top: 2rem;
    margin-bottom: 2.5rem;
  }

  .article-page__content p,
  .article-page__content li,
  .article-page__content div {
    line-height: 1.75;
  }

  .article-page__content p {
    margin-top: 1.25em;
    margin-bottom: 1.25em;
  }

  .article-page__content h2,
  .article-page__content h3,
  .article-page__content h4 {
    font-family: 'Bricolage', serif;
    font-weight: 600;
    line-height: 1.25;
    color: #000;
    margin-top: 2em;
    margin-bottom: 0.75em;
  }

  .article-page__content h2 {
    font-size: 1.75rem;
  }

  .article-page__content h3 {
    font-size: 1.35rem;
  }

  .article-page__content a {
    color: #000;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .article-page__content a:hover,
  .article-page__content a:focus-visible {
    opacity: 0.7;
  }

  .article-page__content blockquote {
    margin-top: 2em;
    margin-bottom: 2em;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 3px solid #000;
    font-size: 1.2rem;
    font-style: italic;
    line-height: 1.6;
    color: #111;
  }

  .article-page__content ul,
  .article-page__content ol {
    margin-top: 1.25em;
    margin-bottom: 1.25em;
    padding-left: 1.4rem;
  }

  .article-page__content li {
    margin-bottom: 0.4em;
  }

  .article-page__content img,
  .article-page__content iframe,
  .article-page__content video {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
    border-radius: 1rem;
  }

  .article-page__content iframe {
    width: 100%;
    min-height: 24rem;
  }

  .article-page__content h2,
  .article-page__content h3,
  .article-page__content h4,
  .article-page__content p,
  .article-page__content ul,
  .article-page__content ol,
  .article-page__content blockquote {
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  .article-page__comments {
    max-width: 42rem;
    margin: 3.5rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid #e5e5e5;
  }

  .article-page__comments-title {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
    font-weight: 600;
    color: #000;
  }

  .article-page__comment-list {
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }

  .article-page__comment {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #ececec;
  }

  .article-page__comment-meta {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: #555;
  }

  .article-page__field {
    margin-bottom: 1rem;
  }

  .article-page__field label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .article-page__field input,
  .article-page__field textarea {
    width: 100%;
    padding: 0.65rem 0.75rem;
    border: 1px solid #ccc;
    border-radius: 0.5rem;
    background: #fff;
  }

  .article-page__submit {
    display: inline-flex;
    padding: 0.7rem 1.25rem;
    border: 0;
    border-radius: 999px;
    background: #000;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }

  .article-page__submit:hover,
  .article-page__submit:focus-visible {
    opacity: 0.8;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "tag": "section",
  "class": "article-page-section",
  "settings": []
}
{% endschema %}
