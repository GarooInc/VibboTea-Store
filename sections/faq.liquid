{% assign padding_top = section.settings.margin_top_image | default: 50 %}
{%- comment -%}
  Cuando el FAQ es la unica seccion de la pagina no hay quien aporte el H1, asi
  que el titulo puede subir a h1. Por defecto sigue siendo h2, para no meter un
  segundo H1 en las paginas donde el FAQ acompana a otras secciones.
{%- endcomment -%}
{% if section.settings.use_as_page_heading %}
  {% assign faq_title_tag = 'h1' %}
{% else %}
  {% assign faq_title_tag = 'h2' %}
{% endif %}
<section id="{{ section.settings.id_section }}" class="faq-section" style="position: relative; z-index: 20;">
<div class="faq-section__wrap w-full bg-white flex flex-col items-center">
  <div class="faq-section__inner min-w-sm mx-auto text-center px-5 md:px-4">

    {% assign img_align = section.settings.image_alignment | default: 'right' %}
    {% assign target_w = section.settings.image_target_width | default: 800 %}
    {% assign target_h_default = section.settings.image_target_height | default: 533 %}
    {% assign auto_size = section.settings.image_auto_size %}

    {% if section.settings.image1 %}
      {% assign orig_w = section.settings.image1.width | default: 0 %}
      {% assign orig_h = section.settings.image1.height | default: 0 %}
      {% if auto_size and orig_w > 0 and orig_h > 0 %}
        {% assign target_h = orig_h | times: target_w | divided_by: orig_w %}
      {% else %}
        {% assign target_h = target_h_default %}
      {% endif %}
    {% endif %}

    <!-- Mascot: absolutely positioned, doesn't affect layout -->
    {% if section.settings.image1 %}
      <div class="hidden md:block absolute top-0 right-0 pointer-events-none" style="width: 220px; margin-top: {{ padding_top }}px; z-index: 2;">
        <img
          src="{{ section.settings.image1 | image_url: width: target_w }}"
          alt=""
          class="w-full object-contain"
          width="{{ target_w }}"
          height="{{ target_h }}"
        >
      </div>
    {% endif %}

    <!-- Header: título/subtítulo centered -->
    <div class="faq-section__header w-full text-center">
      {% if section.settings.title != blank %}
        <{{ faq_title_tag }} class="text-black text-[8vw] md:text-[3.7vw] font-bricolage font-semibold leading-tight mb-7 md:mb-8">
          {{ section.settings.title }}
        </{{ faq_title_tag }}>
      {% endif %}
      <p class="faq-section__subtitle text-xl font-bricolage">
        {{ section.settings.text_faq }}
      </p>
    </div>

    <div class="faq-section__list w-full text-left">
      {% for block in section.blocks %}
      {%- comment -%}
        El modificador --mascot va solo en la ultima pregunta y solo si hay
        imagen: es el que ancla al mono y le reserva el hueco. Asi el hueco no
        se abre en las paginas donde el FAQ va sin mascota.
      {%- endcomment -%}
      {% assign last_with_mascot = false %}
      {% if forloop.last and section.settings.image1 %}
        {% assign last_with_mascot = true %}
      {% endif %}
      <div class="faq-section__item w-full pb-5{% if last_with_mascot %} faq-section__item--mascot{% endif %}" {{ block.shopify_attributes }}>
        <div
          class="faq-card border border-gray-300 rounded-xl px-5 py-5 cursor-pointer"
          data-faq
        >
          <div class="flex items-center justify-between">
            <h3 class="faq-card__question md:text-2xl font-semibold font-bricolage text-gray-800 text-left">
              {{ block.settings.question }}
            </h3>
            <button class="faq-toggle transition-transform duration-300" aria-label="toggle">
              {%- render 'arrow-faq1' -%}
            </button>
          </div>
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-500">
            <p class="faq-card__answer text-gray-700 mt-3 pr-10 text-left max-w-8/9 md:text-lg text-xs pt-3 md:pt-0">
              {{ block.settings.answer }}
            </p>
          </div>
        </div>
        {% comment %}
          En movil la mascota se posiciona como en escritorio: absoluta, sin
          ocupar sitio en el flujo. Antes iba como bloque suelto al final del
          listado y, por mas que se la subiera con margen negativo, abria una
          banda blanca propia y se leia flotando. Ahora cuelga de la ultima
          pregunta y se sienta en el borde inferior de su tarjeta.

          Es decorativa (alt vacio) y va con pointer-events:none para no robarle
          el clic al acordeon. El posicionamiento esta en el <style> de la
          seccion porque el CSS del tema se compila aparte y una clase nueva de
          Tailwind no existiria hasta regenerarlo.
        {% endcomment %}
        {% if last_with_mascot %}
          <div class="md:hidden faq-section__mascot">
            <img
              src="{{ section.settings.image1 | image_url: width: 400 }}"
              alt=""
              class="w-full object-contain"
              width="400"
              height="400"
            >
          </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>

  </div>
</div>
</section>

{%- comment -%}
  FAQPage para que las preguntas sean legibles por maquina. Google ya casi no
  muestra resultados enriquecidos de FAQ, pero los sistemas de IA siguen
  leyendo este bloque para citar respuestas.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | json }}
              }
            }{% unless forloop.last %},{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<style>
  .faq-section__wrap {
    padding-top: 1rem;
    /* en movil las piernas del mono sobresalen de la ultima tarjeta: este
       padding es el que evita que invadan la seccion siguiente */
    padding-bottom: 2.25rem;
  }

  .faq-section__header {
    margin-bottom: 2.75rem;
  }

  /*
    Mascota en movil. En escritorio va absoluta sobre la esquina superior
    derecha; aca se hace lo mismo contra el bloque de preguntas para que no
    abra una banda blanca propia debajo del listado.

    Se reserva espacio dentro de la ultima tarjeta (padding-bottom) para que el
    mono tenga donde sentarse sin pisar ni la pregunta ni la respuesta abierta,
    y la imagen se apoya en el borde inferior de esa tarjeta.
  */
  @media (max-width: 767px) {
    .faq-section__item--mascot {
      position: relative;
    }

    /*
      Hueco al pie de la ultima tarjeta (80px): es la franja donde entra el
      torso del mono. Al ser fijo, la separacion con la pregunta es la misma
      tenga una linea o tres, y tambien con la respuesta abierta.
    */
    .faq-section__item--mascot .faq-card {
      padding-bottom: 5rem;
    }

    .faq-section__mascot {
      position: absolute;
      right: 0.25rem;
      /*
        La imagen mide 116px y el mono se sienta a ~66% de su alto, asi que le
        quedan ~39px de piernas: con bottom -19px (el item ya trae pb-5 = 20px)
        la cadera cae justo sobre el borde inferior de la tarjeta y las piernas
        cuelgan por fuera.
      */
      bottom: -19px;
      width: 116px;
      pointer-events: none;
      z-index: 3;
    }
  }

  @media (min-width: 768px) {
    .faq-section__wrap {
      padding-top: 1.5rem;
      padding-bottom: 1.5rem;
    }

    .faq-section__inner {
      width: min(94vw, 1240px);
    }

    .faq-section__header {
      margin-bottom: 2.5rem;
    }

    .faq-section__subtitle {
      font-size: 1.35rem;
    }

    .faq-section__item {
      padding-bottom: 1.25rem;
    }

    .faq-card {
      padding: 1.75rem 2.5rem;
      border-radius: 1rem;
    }

    .faq-card__question {
      font-size: 1.75rem;
      line-height: 1.25;
    }

    .faq-card__answer {
      font-size: 1.125rem;
      line-height: 1.6;
      padding-top: 0.75rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const faqs = document.querySelectorAll("[data-faq]");

    faqs.forEach(faq => {
      const toggle = faq.querySelector(".faq-toggle");
      const content = faq.querySelector(".faq-content");

      faq.addEventListener("click", () => {
        const isOpen = content.style.maxHeight && content.style.maxHeight !== "0px";

        if (isOpen) {
          content.style.maxHeight = "0px";
          toggle.style.transform = "rotate(0deg)";
        } else {
          content.style.maxHeight = content.scrollHeight + "px";
          toggle.style.transform = "rotate(180deg)";
        }
      });
    });
  });
</script>


{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título principal",
      "default": "Preguntas frecuentes"
    },
    {
      "type": "checkbox",
      "id": "use_as_page_heading",
      "label": "Use title as the page H1",
      "info": "Activar solo si el FAQ es la unica seccion de la pagina.",
      "default": false
    },
    {
      "type": "text",
      "id": "id_section",
      "label": "Nombre de la seccion",
      "default": "#faqContact"
    },
    {
      "type": "textarea",
      "id": "text_faq",
      "label": "Texto secundiario",
      "default": "Read below for a good time."
    },
    {
     "type": "image_picker", 
     "id": "image1", 
      "label": "Image1"
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Alineación de la imagen",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "right"
    },
  
   
    {
      "type": "number",
      "id": "margin_top_image",
      "label": "Padding por deceto (px)",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Respuesta"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
