{% assign padding_top = section.settings.margin_top_image | default: 50 %}
{%- comment -%}
  Cuando el FAQ es la unica seccion de la pagina no hay quien aporte el H1, asi
  que el titulo puede subir a h1. Por defecto sigue siendo h2, para no meter un
  segundo H1 en las paginas donde el FAQ acompana a otras secciones.
{%- endcomment -%}
{% if section.settings.use_as_page_heading %}
  {% assign faq_title_tag = 'h1' %}
{% else %}
  {% assign faq_title_tag = 'h2' %}
{% endif %}
<section id="{{ section.settings.id_section }}" class="faq-section" style="position: relative; z-index: 20;">
<div class="faq-section__wrap w-full bg-white flex flex-col items-center">
  <div class="faq-section__inner min-w-sm mx-auto text-center px-5 md:px-4">

    {% assign img_align = section.settings.image_alignment | default: 'right' %}
    {% assign target_w = section.settings.image_target_width | default: 800 %}
    {% assign target_h_default = section.settings.image_target_height | default: 533 %}
    {% assign auto_size = section.settings.image_auto_size %}

    {% if section.settings.image1 %}
      {% assign orig_w = section.settings.image1.width | default: 0 %}
      {% assign orig_h = section.settings.image1.height | default: 0 %}
      {% if auto_size and orig_w > 0 and orig_h > 0 %}
        {% assign target_h = orig_h | times: target_w | divided_by: orig_w %}
      {% else %}
        {% assign target_h = target_h_default %}
      {% endif %}
    {% endif %}

    {% comment %}
      Mascota de escritorio: markup original (commit 33f8279), restaurado tal
      cual. Anclada a la esquina superior derecha de toda la seccion, no del
      listado -separada a proposito del bloque movil de abajo, porque cada una
      necesita su propio punto de referencia y su propio offset vertical; no
      comparten mecanismo aunque sean la misma imagen.
    {% endcomment %}
    {% if section.settings.image1 %}
      <div class="hidden md:block absolute top-0 right-0 pointer-events-none" style="width: 220px; margin-top: 50px; z-index: 2;">
        <img
          src="{{ section.settings.image1 | image_url: width: target_w }}"
          alt=""
          class="w-full object-contain"
          width="{{ target_w }}"
          height="{{ target_h }}"
        >
      </div>
    {% endif %}

    <!-- Header: título/subtítulo centered -->
    <div class="faq-section__header w-full text-center">
      {% if section.settings.title != blank %}
        <{{ faq_title_tag }} class="text-black text-[8vw] md:text-[3.7vw] font-bricolage font-semibold leading-tight mb-7 md:mb-8">
          {{ section.settings.title }}
        </{{ faq_title_tag }}>
      {% endif %}
      <p class="faq-section__subtitle text-xl font-bricolage">
        {{ section.settings.text_faq }}
      </p>
    </div>

    <div class="faq-section__list w-full text-left" style="position: relative;">
      {% comment %}
        Mascota de movil: separada de la de escritorio (ver arriba). Esta va
        md:hidden, anclada a la esquina superior derecha del LISTADO, no de
        toda la seccion -el titulo usa text-[8vw] y crece con el ancho de
        pantalla, asi que anclarla contra el inicio de la seccion la hacia
        caer encima del subtitulo en pantallas angostas. "Arriba" aqui es
        literalmente donde arranca la primera pregunta. padding_top sigue
        siendo configurable: es cuanto se mete hacia abajo desde ese punto
        (negativo = sube y se asoma sobre el borde de la primera tarjeta).
      {% endcomment %}
      {% if section.settings.image1 %}
        <div class="md:hidden faq-section__mascot" style="margin-top: {{ padding_top }}px;">
          <img
            src="{{ section.settings.image1 | image_url: width: target_w }}"
            alt=""
            class="w-full object-contain"
            width="{{ target_w }}"
            height="{{ target_h }}"
          >
        </div>
      {% endif %}
      {% for block in section.blocks %}
      <div class="faq-section__item w-full pb-5" {{ block.shopify_attributes }}>
        <div
          class="faq-card border border-gray-300 rounded-xl px-5 py-5 cursor-pointer"
          data-faq
        >
          <div class="flex items-center justify-between">
            <h3 class="faq-card__question md:text-2xl font-semibold font-bricolage text-gray-800 text-left">
              {{ block.settings.question }}
            </h3>
            <button class="faq-toggle transition-transform duration-300" aria-label="toggle">
              {%- render 'arrow-faq1' -%}
            </button>
          </div>
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-500">
            <p class="faq-card__answer text-gray-700 mt-3 pr-10 text-left max-w-8/9 md:text-lg text-xs pt-3 md:pt-0">
              {{ block.settings.answer }}
            </p>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>

  </div>
</div>
</section>

{%- comment -%}
  FAQPage para que las preguntas sean legibles por maquina. Google ya casi no
  muestra resultados enriquecidos de FAQ, pero los sistemas de IA siguen
  leyendo este bloque para citar respuestas.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | json }}
              }
            }{% unless forloop.last %},{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<style>
  .faq-section__wrap {
    padding-top: 1rem;
    padding-bottom: 1.25rem;
  }

  .faq-section__header {
    margin-bottom: 2.75rem;
  }

  /*
    Mascota de movil (la de escritorio es la original: inline style, sin esta
    clase). Absoluta sobre la esquina superior derecha del LISTADO -no de toda
    la seccion- para que no dependa del alto que termine ocupando el titulo.

    El listado mide 390px de viewport con 20px de margen a cada lado (medido
    con getBoundingClientRect: el borde del listado cae en x=370). right:-20px
    es el maximo que sangra hasta el borde de pantalla sin salirse: mas
    negativo saca la mascota del viewport y la recorta o genera scroll
    horizontal, porque la seccion no tiene overflow-hidden.

    pointer-events: none para no robarle el clic al acordeon.
  */
  .faq-section__mascot {
    position: absolute;
    top: 0;
    right: -20px;
    width: 100px;
    pointer-events: none;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .faq-section__wrap {
      padding-top: 1.5rem;
      padding-bottom: 1.5rem;
    }

    .faq-section__inner {
      width: min(94vw, 1240px);
    }

    .faq-section__header {
      margin-bottom: 2.5rem;
    }

    .faq-section__subtitle {
      font-size: 1.35rem;
    }

    .faq-section__item {
      padding-bottom: 1.25rem;
    }

    .faq-card {
      padding: 1.75rem 2.5rem;
      border-radius: 1rem;
    }

    .faq-card__question {
      font-size: 1.75rem;
      line-height: 1.25;
    }

    .faq-card__answer {
      font-size: 1.125rem;
      line-height: 1.6;
      padding-top: 0.75rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const faqs = document.querySelectorAll("[data-faq]");

    faqs.forEach(faq => {
      const toggle = faq.querySelector(".faq-toggle");
      const content = faq.querySelector(".faq-content");

      faq.addEventListener("click", () => {
        const isOpen = content.style.maxHeight && content.style.maxHeight !== "0px";

        if (isOpen) {
          content.style.maxHeight = "0px";
          toggle.style.transform = "rotate(0deg)";
        } else {
          content.style.maxHeight = content.scrollHeight + "px";
          toggle.style.transform = "rotate(180deg)";
        }
      });
    });
  });
</script>


{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título principal",
      "default": "Preguntas frecuentes"
    },
    {
      "type": "checkbox",
      "id": "use_as_page_heading",
      "label": "Use title as the page H1",
      "info": "Activar solo si el FAQ es la unica seccion de la pagina.",
      "default": false
    },
    {
      "type": "text",
      "id": "id_section",
      "label": "Nombre de la seccion",
      "default": "#faqContact"
    },
    {
      "type": "textarea",
      "id": "text_faq",
      "label": "Texto secundiario",
      "default": "Read below for a good time."
    },
    {
     "type": "image_picker", 
     "id": "image1", 
      "label": "Image1"
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Alineación de la imagen",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "right"
    },
  
   
    {
      "type": "number",
      "id": "margin_top_image",
      "label": "Posicion vertical de la mascota (px)",
      "info": "Se mide desde donde arranca la primera pregunta, no desde arriba de toda la seccion. Negativo la sube para que se asome sobre el borde de la tarjeta.",
      "default": -58
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Respuesta"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
