{%- liquid
  assign skip_blog_nav = false
  if section.settings.submenu1_footer != blank
    for link in section.settings.submenu1_footer.links
      if link.url contains '/blogs/'
        assign skip_blog_nav = true
      endif
    endfor
  endif
  if section.settings.submenu2_footer != blank
    for link in section.settings.submenu2_footer.links
      if link.url contains '/blogs/'
        assign skip_blog_nav = true
      endif
    endfor
  endif
  if section.settings.submenu3_footer != blank
    for link in section.settings.submenu3_footer.links
      if link.url contains '/blogs/'
        assign skip_blog_nav = true
      endif
    endfor
  endif
  if section.settings.menu2_footer != blank and linklists[section.settings.menu2_footer].links.size > 0
    for link in linklists[section.settings.menu2_footer].links
      if link.url contains '/blogs/'
        assign skip_blog_nav = true
      endif
    endfor
  endif
-%}
<footer
  class="w-screen md:min-h-0 min-h-[40vh] bg-[#1D1D1B] text-white"
  style="width: 100vw; margin-left: calc(50% - 50vw);"
>
  <!-- VERSION MOBILE -->
  <div class="md:hidden flex py-10 w-full flex-col items-center justify-between px-5">
    <!-- LOGO -->
    <div class="w-full flex flex-col items-center justify-start px-5 py-10">
      {% if section.settings.logo %}
        <img 
          src="{{ section.settings.logo | image_url: width: 300 }}" 
          alt="Logo"
          class="w-30 object-contain mx-auto"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
        >
      {% endif %}
      {% if section.settings.descripcion %}
      <p class="md:text-[1.2vw] text-xs text-white mt-2 pt-5 md:pr-[15vw] font-bricolage leading-tight">
        {{ section.settings.descripcion | newline_to_br}}
      </p>
    {% endif %}
    </div>
     <!-- NAV: Shop y About lado a lado -->
    <nav class="w-full grid grid-cols-2 justify-items-center gap-x-8 py-8 max-w-md mx-auto">
      {% if section.settings.submenu1_footer != blank %}
        <div class="flex flex-col items-center">
          {% for link in section.settings.submenu1_footer.links %}
            {% if forloop.first %}
              <h2 class="text-lg font-bricolage mb-3">{{ link.title }}</h2>
            {% else %}
              <a href="{% render 'menu-link-url', link: link %}" class="text-sm font-bricolage opacity-80 mb-2 hover:opacity-60 transition-opacity">
                {{ link.title }}
              </a>
            {% endif %}
          {% endfor %}
          {% if section.settings.submenu2_footer != blank %}
            {% for link in section.settings.submenu2_footer.links %}
              {% assign link_title_down = link.title | downcase | strip %}
              {% if link_title_down == 'wholesale' %}
                <a href="{% render 'menu-link-url', link: link %}" class="text-sm font-bricolage opacity-80 mb-2 hover:opacity-60 transition-opacity">
                  {{ link.title }}
                </a>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.submenu2_footer != blank %}
        <div class="flex flex-col items-center">
          {% for link in section.settings.submenu2_footer.links %}
            {% assign link_title_down = link.title | downcase | strip %}
            {% if link_title_down == 'wholesale' %}
              {% continue %}
            {% endif %}
            {% if forloop.first %}
              <a href="{% render 'menu-link-url', link: link %}" class="text-lg font-bricolage mb-3">
                {{ link.title }}
              </a>
            {% else %}
              <a href="{% render 'menu-link-url', link: link %}" class="text-sm font-bricolage opacity-80 mb-2 hover:opacity-60 transition-opacity">
                {{ link.title }}
              </a>
            {% endif %}
          {% endfor %}
          {% render 'blog-nav-link', skip: skip_blog_nav, class: 'text-sm font-bricolage opacity-80 mb-2 hover:opacity-60 transition-opacity' %}
        </div>
      {% endif %}
    </nav>

    {%- liquid
      assign x_href = section.settings.x_url
      if section.settings.submenu3_footer != blank
        for link in section.settings.submenu3_footer.links
          assign social_title = link.title | downcase | strip
          if social_title == 'x' or social_title == 'twitter'
            assign x_href = link.url
          endif
        endfor
      endif
      if x_href == blank
        assign x_href = 'https://x.com/drinkvibbo'
      endif
    -%}

    <!-- SOCIALS: debajo de Shop y About -->
    <div class="flex items-center justify-center gap-4 py-4">
        {% if section.settings.facebook_url != blank %}
        <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener"
          class="footer-icon hover:opacity-70 transition-opacity scale-70"
          aria-label="Facebook">
          {%- render 'fb' -%}
        </a>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener"
          class="footer-icon hover:opacity-70 transition-opacity scale-70"
          aria-label="Instagram">
          {%- render 'ig' -%}
        </a>
        {% endif %}
        {% if section.settings.tiktok_url != blank %}
        <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener"
          class="footer-icon hover:opacity-70 transition-opacity scale-80"
          aria-label="Tiktok">
          {%- render 'tiktok' -%}
        </a>
        {% endif %}
        <a href="{{ x_href }}" target="_blank" rel="noopener"
          class="footer-icon hover:opacity-70 transition-opacity scale-70"
          aria-label="X">
          {%- render 'x' -%}
        </a>
      </div>

      <div>
        {% if section.settings.descripcion2 %}
          <p class=" md:text-sm text-xs w-screen
            text-center text-white font-bricolage
            leading-tight py-5 md:pt-0 pt-10 uppercase px-5">
            {{ section.settings.descripcion2 }}
          </p>
        {% endif %}
      </div>
     <!-- OTROS -->
    <div class="flex flex-row flex-wrap justify-center space-y-1 py-10 pt-12">
        {% if section.settings.menu and linklists[section.settings.menu2_footer] and linklists[section.settings.menu2_footer].links.size > 0 %}
          {% for link in linklists[section.settings.menu2_footer].links %}
            <a href="{% render 'menu-link-url', link: link %}" class="hover:opacity-70 whitespace-nowrap text-sm    transition-opacity pr-5">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a class="hover:opacity-70 whitespace-nowrap  text-sm transition-opacity pr-5">Privacy Policy</a>
          <a class="hover:opacity-70 whitespace-nowrap  text-sm pr-5">Terms of Service</a>
          <a class="hover:opacity-70 whitespace-nowrap  text-sm">Cookies Policy</a>
        {% endif %}
      </div>
  </div>

  <!-- VERSION DESKTOP -->
  <div class="hidden md:flex w-full items-start justify-between gap-10 px-20 pt-6 pb-6">

    <!-- COL 1: LOGO + DESCRIPCION + REDES -->
    <div class="flex flex-col items-start w-[34%]">
      <div>
        {% if section.settings.logo %}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            alt="Logo"
            class="w-40 object-contain"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
          >
        {% endif %}
        {% if section.settings.descripcion %}
          <p class="md:text-[1.1vw] text-xs text-white mt-2 pt-5 md:pr-8 font-bricolage leading-tight">
            {{ section.settings.descripcion }}
          </p>
        {% endif %}
      </div>

      <!-- redes sociales -->
      <div class="flex pl-2 gap-4 mt-8">
        <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener"
          class="footer-icon hover:opacity-70 transition-opacity scale-70" aria-label="Facebook">
          {%- render 'fb' -%}
        </a>
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener"
          class="footer-icon hover:opacity-70 transition-opacity scale-70" aria-label="Instagram">
          {%- render 'ig' -%}
        </a>
        <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener"
          class="footer-icon hover:opacity-70 transition-opacity scale-80" aria-label="Tiktok">
          {%- render 'tiktok' -%}
        </a>
      </div>
    </div>

    <!-- COLS 2-4: NAV -->
    <nav class="flex flex-row justify-between flex-1 pl-8">

      <div class="flex flex-col items-start">
        {% for link in section.settings.submenu1_footer.links %}
          {% if forloop.first %}
            <h2 class="md:text-[1.8vw] text-lg font-bricolage mb-4 whitespace-nowrap">
              {{ link.title }}
            </h2>
          {% else %}
            <a href="{% render 'menu-link-url', link: link %}" class="md:text-[1vw] text-[10px] font-bricolage opacity-80 mb-2 whitespace-nowrap hover:opacity-60 transition-opacity">
              {{ link.title }}
            </a>
          {% endif %}
        {% endfor %}
      </div>

      <div class="flex flex-col items-start">
        {% for link in section.settings.submenu2_footer.links %}
          {% if forloop.first %}
            <a href="{% render 'menu-link-url', link: link %}" class="md:text-[1.8vw] text-lg font-bricolage mb-4 whitespace-nowrap">
              {{ link.title }}
            </a>
          {% else %}
            <a href="{% render 'menu-link-url', link: link %}" class="md:text-[1vw] text-[10px] font-bricolage opacity-80 mb-2 whitespace-nowrap hover:opacity-60 transition-opacity">
              {{ link.title }}
            </a>
          {% endif %}
        {% endfor %}
        {% render 'blog-nav-link', skip: skip_blog_nav, class: 'md:text-[1vw] text-[10px] font-bricolage opacity-80 mb-2 whitespace-nowrap hover:opacity-60 transition-opacity' %}
      </div>

      <div class="flex flex-col items-start">
        {% for link in section.settings.submenu3_footer.links %}
          {% if forloop.first %}
            <h2 class="md:text-[1.8vw] text-lg font-bricolage mb-4 whitespace-nowrap">
              {{ link.title }}
            </h2>
          {% else %}
            <a href="{% render 'menu-link-url', link: link %}" class="md:text-[1vw] text-[10px] font-bricolage opacity-80 mb-2 whitespace-nowrap hover:opacity-60 transition-opacity">
              {{ link.title }}
            </a>
          {% endif %}
        {% endfor %}
      </div>

    </nav>

  </div><!-- end desktop columns wrapper -->

  <!-- DESCRIPCION FULL WIDTH - DESKTOP -->
  {% if section.settings.descripcion2 %}
    <div class="footer-desc-full">
      <p style="color:white; font-family:'Bricolage Grotesque',sans-serif; font-size:0.875rem; text-transform:uppercase; text-align:center; line-height:1.2;">
        {{ section.settings.descripcion2 }}
      </p>
    </div>
    <style>
      .footer-desc-full { display: none; width: 100%; padding: 0 5rem 2.5rem; margin-top: 0; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 1.5rem; }
      @media (min-width: 768px) { .footer-desc-full { display: flex; justify-content: center; } }
    </style>
  {% endif %}

  <!-- PRIVACY LINKS - DESKTOP -->
  <div class="footer-privacy-links" style="display:none; width:100%; padding: 0 5rem 2rem;">
    {% if section.settings.menu and linklists[section.settings.menu2_footer] and linklists[section.settings.menu2_footer].links.size > 0 %}
      {% for link in linklists[section.settings.menu2_footer].links %}
        <a href="{% render 'menu-link-url', link: link %}" class="hover:opacity-70 whitespace-nowrap text-xs md:text-lg transition-opacity pr-5">{{ link.title }}</a>
      {% endfor %}
    {% else %}
      <a class="hover:opacity-70 whitespace-nowrap text-xs md:text-lg transition-opacity pr-5">Privacy Policy</a>
      <a class="hover:opacity-70 whitespace-nowrap text-xs md:text-lg pr-5">Terms of Service</a>
      <a class="hover:opacity-70 whitespace-nowrap text-xs md:text-lg">Cookies Policy</a>
    {% endif %}
  </div>
  <style>
    @media (min-width: 768px) { .footer-privacy-links { display: flex !important; justify-content: center; } }
  </style>

</footer>






{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "submenu1_footer",
      "label": "t:labels.menu"
    },

    {
      "type": "link_list",
      "id": "submenu2_footer",
      "label": "t:labels.menu"
    },

    {
      "type": "link_list",
      "id": "submenu3_footer",
      "label": "t:labels.menu"
    },

    {
      "type": "link_list",
      "id": "menu2_footer",
      "label": "Terms menu"
    },
   
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "textarea",
      "id": "descripcion",
      "label": "Description",
      "default": "Bienvenido a Nuestra Tienda"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "text",
      "id": "descripcion2",
      "label": "Description 2",
      "default": "Bienvenido a Nuestra Tienda"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "Tiktok URL"
    },
    {
      "type": "url",
      "id": "x_url",
      "label": "X URL"
    },
  ]
}
{% endschema %}
