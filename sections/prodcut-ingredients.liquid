<div
  class="ingredients-section w-full xl:py-10 py-15 {% if section.settings.imagen2 or section.settings.imagen3 %}xl:pb-40 pb-25{% else %}xl:pb-16 pb-12{% endif %} overflow-hidden bg-[#F5F5F5] relative flex flex-col items-center justify-center"
  style="width: 100vw; margin-left: calc(50% - 50vw);"
>

<div class="w-full h-full mx-auto flex flex-col items-center justify-center ">

  {% if section.settings.title %}
  <h2 class="text-center md:text-5xl text-[8vw] text-black font-normal font-bricolage md:pb-20 pb-15">
    {{ section.settings.title }}
  </h2>
  {% endif %}

  <!-- WRAPPER DEL CARRUSEL -->
  <div class="relative w-full overflow-visible flex items-center" data-snap-slider data-snap-loop data-snap-focus>

    <!-- Botón Prev -->
    <button
      type="button"
      data-snap-prev
      class="absolute left-2 md:left-6 z-10 hover:opacity-70 transition-opacity scale-75 md:scale-90"
      aria-label="Anterior"
    >
      <svg width="57" height="57" viewBox="0 0 57 57" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="28.2843" y="56.5685" width="40" height="40" rx="20" transform="rotate(-135 28.2843 56.5685)" fill="white" stroke="black" stroke-width="1.5"/>
        <path d="M21.2839 28.2843H35.2846" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M26.1629 33.234L21.2832 28.285L26.1629 23.3345" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <!-- TRACK: scroll manual (dedo o flechas), 3 copias para el loop -->
    <div class="snap-track flex md:gap-10 gap-8 items-center" data-snap-track>
      {% for i in (1..3) %}
          {% for block in section.blocks %}
          <div {% if i != 2 %}aria-hidden="true" {% endif %}class="ingredient-card md:min-w-[20vw] min-w-[60vw] xs:min-h-[45vw] w-full bg-white
            rounded-xl flex flex-col items-center justify-center card-focus
            {% if block.settings.title == 'Raisins' %}card-raisins{% endif %}">
            <div class="md:h-[18vw] h-[50vw] items-center justify-center flex">
              <img
                src="{{ block.settings.image | image_url: width: 400 }}"
                alt="{{ block.settings.title }}"
                class="w-32 h-32 md:w-44 md:h-44 object-contain p-4 md:p-6"
                width="176"
                height="176"
              >
            </div>
            <h3 class="font-medium text-black font-bricolage xl:text-lg text-base">
              {{ block.settings.title }}</h3>
            <p class="text-black md:min-h-[8vw] min-h-[15vw]
              font-bricolage text-center md:text-[0.9vw] text-[3vw] py-5 md:px-4 px-6">
              {{ block.settings.text }}</p>
          </div>
          {% endfor %}
      {%  endfor %}
    </div>

    <!-- Botón Next -->
    <button
      type="button"
      data-snap-next
      class="absolute right-2 md:right-6 z-10 hover:opacity-70 transition-opacity scale-75 md:scale-90"
      aria-label="Siguiente"
    >
      <svg width="57" height="57" viewBox="0 0 57 57" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="28.2843" width="40" height="40" rx="20" transform="rotate(45 28.2843 0)" fill="white" stroke="black" stroke-width="1.5"/>
        <path d="M35.2846 28.2843H21.2839" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M30.4054 23.3345L35.2851 28.2835L30.4054 33.234" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

  </div>

  </div>
</div>

{% if section.settings.imagen1 %}
  <div class="absolute md:top-5 md:-translate-y-30 -translate-y-25 right-0 transform ">
    <img
      src="{{ section.settings.imagen1 | image_url: width: 1000 }}"
      alt="{{ section.settings.imagen1.alt | escape }}"
      class="md:w-[15vw] w-[25vw] object-cover "
      width="{{ section.settings.imagen1.width }}"
      height="{{ section.settings.imagen1.height }}"
    />
  </div>
{% endif %}
{% if section.settings.imagen2 %}
  <div class="ingredients-leaf absolute md:left-0 bottom-0 md:translate-y-[25vw] translate-y-[45vw] md:-translate-x-15 -translate-x-20 transform">
    <img
      src="{{ section.settings.imagen2 | image_url: width: 1000 }}"
      alt="{{ section.settings.imagen2.alt | escape }}"
      class="md:w-[35vw] w-[65vw] object-cover block"
      width="{{ section.settings.imagen2.width }}"
      height="{{ section.settings.imagen2.height }}"
    />
  </div>
{% endif %}
{% if section.settings.imagen3 %}
  <div class="hidden md:block absolute right-20 translate-y-35 -bottom-12 transform">
    <img
      src="{{ section.settings.imagen3 | image_url: width: 1000 }}"
      alt="{{ section.settings.imagen3.alt | escape }}"
      class="w-[35vw] object-cover block"
      width="{{ section.settings.imagen3.width }}"
      height="{{ section.settings.imagen3.height }}"
    />
  </div>
{% endif %}

<style>
  {%- unless section.settings.imagen2 or section.settings.imagen3 %}
  /* Mobile: el aire de abajo ya lo da el padding del slider; sin esto quedaba
     casi el doble de espacio bajo las tarjetas que sobre el titulo. */
  /* y menos aire arriba y entre titulo y tarjetas */
  @media (max-width: 767px) {
    .ingredients-section { padding-top: 40px; padding-bottom: 0; }
    .ingredients-section h2 { padding-bottom: 24px; }
  }
  {%- else %}
  /* Con ilustraciones (paginas de producto): mismo ajuste de arriba. La hoja
     inferior va encima de las tarjetas, asi que abajo ya no hace falta reservarle
     espacio. */
  @media (max-width: 767px) {
    .ingredients-section { padding-top: 40px; padding-bottom: 8px; }
    .ingredients-section h2 { padding-bottom: 24px; }
  }
  {%- endunless %}

  @media (max-width: 767px) {
    /* La hoja va encima de las tarjetas, montada sobre la esquina inferior
       izquierda (asi lo pidio el cliente). Los toques pasan a traves. */
    .ingredients-leaf { z-index: 20; pointer-events: none; bottom: -50px; }
  }

  .card-focus {
    transition: transform 0.4s ease, opacity 0.4s ease;
    transform: scale(0.95);
  }

  .card-focus.is-center {
    transform: scale(1.2);
    opacity: 1;
    z-index: 10;
  }

  .card-focus img {
    transition: transform 0.4s ease;
  }

  .card-focus.is-center img {
    transform: scale(1.1);
  }

  .card-raisins img {
    padding: 2.5rem;
  }
</style>

{% render 'snap-slider' %}

{% schema %}
{
  "name": "Product Ingredients",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Product Ingredients"
    },
    {
      "type": "image_picker",
      "id": "imagen1",
      "label": "Imagen 1"
    },
    {
      "type": "image_picker",
      "id": "imagen2",
      "label": "Imagen 2"
    },
    {
      "type": "image_picker",
      "id": "imagen3",
      "label": "Imagen 3"
    }
  ],
  "blocks": [
    {
      "type": "ingredient_block",
      "name": "Ingredient Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ingredient Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Ingredient description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Ingredients",
      "category": "Productos"
    }
  ]
}
{% endschema %}
