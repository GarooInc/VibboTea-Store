<div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start w-full max-w-full min-w-0
   md:px-5 md:py-10 md:pt-28 pt-20">

  {% if product %}
    {% assign current_variant = product.selected_or_first_available_variant %}

    {% liquid
      assign quote_text = ''
      assign quote_author = ''
      assign quote_verified = false
      assign show_bundle_quotes = false
      if product.handle == 'all-day-bundle-pack'
        assign show_bundle_quotes = true
      endif
      case product.handle
        when 'hydra-boost-natural-energy'
          assign quote_text = 'This tea is absolutely 10/10 in flavor — rich, smooth, and incredibly enjoyable with every cup. The tea bags are super practical and make preparing tea quick, easy, and mess-free.'
          assign quote_author = 'Andres B.'
          assign quote_verified = true
        when 'gut-bliss-natural-detox'
          assign quote_text = "I've been drinking this after meals and it really feels clean and easy on my stomach. It has a fresh taste and doesn't feel heavy to me like other herbal teas.."
          assign quote_author = 'Silvia P.'
        when 'chill-vibes-natural-relax'
          assign quote_text = 'It is sooo delicious! Congrats! Great and healthy product!'
          assign quote_author = 'Annabella V.'
          assign quote_verified = true
      endcase
    %}

    <!-- MOBILE: Review card above image -->
    <div class="md:hidden w-full">
      {% if show_bundle_quotes %}
        {% render 'product-quote-carousel',
          bg_color: section.settings.per_serving_bg_color,
          suffix: 'mobile'
        %}
      {% elsif quote_text != blank %}
        <div class="product-quote-box" style="background-color: {{ section.settings.per_serving_bg_color }};">
          <p class="product-quote-box__text">&ldquo;{{ quote_text }}&rdquo;</p>
          <div class="product-quote-box__author-row">
            <span class="product-quote-box__avatar">{{ quote_author | slice: 0 }}</span>
            <span class="product-quote-box__author">{{ quote_author }}</span>
            {% if quote_verified %}
              <span class="product-quote-box__verified">Verified</span>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <!-- Judge.me reviews -->
      <div class="mb-4" style="margin-top: 24px;">
        <div class='jdgm-widget jdgm-preview-badge jdgm--done' data-id='{{ product.id }}' style="font-size: 1.3rem;">
          {{ product.metafields.judgeme.badge }}
        </div>
      </div>
    </div>

    {% if product.media.size > 1 %}

    <!-- DESKTOP: Imagen principal + grid de miniaturas abajo -->
    <div class="hidden md:flex flex-col gap-3 w-full min-w-0 overflow-hidden md:sticky md:top-32 md:self-start z-10">
      <div class="w-full rounded-xl overflow-hidden relative" id="mainImageDesktop">
        {% assign first_media = product.media[0] %}
        {% if first_media.media_type == "image" %}
          <img
            src="{{ first_media | image_url: width: 1200 }}"
            alt="{{ first_media.alt | escape }}"
            class="w-full h-auto block"
            id="mainDesktopImg"
            width="{{ first_media.width }}"
            height="{{ first_media.height }}"
          />
        {% elsif first_media.media_type == "video" %}
          <video autoplay loop muted playsinline class="w-full h-auto block" id="mainDesktopVideo">
            <source src="{{ first_media.sources[1].url }}" type="video/mp4">
          </video>
        {% endif %}
        <button class="absolute left-0 top-1/2 -translate-y-1/2 text-black px-3 py-2 cursor-pointer z-10" onclick="desktopPrev()">
          {% render 'arrow-slidder2' %}
        </button>
        <button class="absolute right-0 top-1/2 -translate-y-1/2 text-black px-3 py-2 cursor-pointer z-10" onclick="desktopNext()">
          {% render 'arrow-slidder' %}
        </button>
      </div>
      <div class="grid grid-cols-3 xl:grid-cols-4 w-full" style="gap: 8px;">
        {% for media in product.media %}
          {% assign is_video = false %}
          {% if media.media_type == "video" or media.media_type == "external_video" %}
            {% assign is_video = true %}
          {% endif %}
          <button
            class="desktop-thumb rounded-lg overflow-hidden border-2 transition-all duration-200 cursor-pointer {% if is_video %}col-span-2{% else %}aspect-square{% endif %} {% if forloop.first %}border-black opacity-100{% else %}border-transparent opacity-60{% endif %}"
            {% if is_video %}style="aspect-ratio: 2 / 1;"{% endif %}
            data-src="{{ media | image_url: width: 1200 }}"
            data-alt="{{ media.alt | escape }}"
            data-type="{{ media.media_type }}"
            {% if media.media_type == "video" %}data-video="{{ media.sources[1].url }}"{% endif %}
            {% if media.media_type == "external_video" %}data-video="{{ media.sources[0].url }}"{% endif %}
            aria-label="Ver imagen {{ forloop.index }}"
          >
            <img
              src="{{ media.preview_image | image_url: width: 400 }}"
              alt="{{ media.alt | escape }}"
              class="w-full h-full object-cover"
            />
          </button>
        {% endfor %}
      </div>
    </div>

    <!-- MOBILE: Carrusel -->
    <div class="md:hidden flex flex-col gap-3">

      <div class="relative w-full overflow-hidden rounded-xl" id="productSlider">

        <div class="flex transition-transform duration-500" id="sliderTrack">
          {% for media in product.media %}
            <div class="w-full h-full shrink-0 aspect-square overflow-hidden rounded-xl">
              {% if media.media_type == "image" %}
                <img
                  src="{{ media | image_url: width: 1200 }}"
                  alt="{{ media.alt | escape }}"
                  class="w-full h-full object-cover"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                />
              {% elsif media.media_type == "video" %}
                <video autoplay loop muted playsinline class="w-full h-full object-cover">
                  <source src="{{ media.sources[1].url }}" type="video/mp4">
                </video>
              {% elsif media.media_type == "external_video" %}
                {% if media.host == "youtube" %}
                  <iframe
                    src="https://www.youtube.com/embed/{{ media.external_id }}?autoplay=1&mute=1&loop=1&playlist={{ media.external_id }}&controls=0&modestbranding=1&rel=0"
                    class="w-full h-full" frameborder="0"
                    allow="autoplay; encrypted-media" allowfullscreen
                  ></iframe>
                {% elsif media.host == "vimeo" %}
                  <iframe
                    src="https://player.vimeo.com/video/{{ media.external_id }}?autoplay=1&muted=1&loop=1&background=1&controls=0"
                    class="w-full h-full" frameborder="0"
                    allow="autoplay; fullscreen" allowfullscreen
                  ></iframe>
                {% endif %}
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <!-- BOTONES -->
        <button class="absolute left-0 top-1/2 -translate-y-1/2 text-black px-3 py-2 cursor-pointer" onclick="slidePrev()">
          {% render 'arrow-slidder2' %}
        </button>
        <button class="absolute right-0 top-1/2 -translate-y-1/2 text-black px-3 py-2 cursor-pointer" onclick="slideNext()">
          {% render 'arrow-slidder' %}
        </button>
      </div>

      <!-- MINIATURAS -->
      <div class="flex gap-2 overflow-x-auto pb-1 justify-center" id="thumbnailStrip">
        {% for media in product.media %}
          <button
            class="thumbnail-btn shrink-0 w-18 h-18 rounded-lg overflow-hidden border-2 transition-all duration-200 cursor-pointer {% if forloop.first %}border-black opacity-100{% else %}border-transparent opacity-60{% endif %}"
            onclick="goToSlide({{ forloop.index0 }})"
            aria-label="Ver imagen {{ forloop.index }}"
          >
            <img
              src="{{ media.preview_image | image_url: width: 200 }}"
              alt="{{ media.alt | escape }}"
              class="w-full h-full object-cover"
            />
          </button>
        {% endfor %}
      </div>

    </div>

    {% else %}
      <div class="product-media w-full justify-center">
        {% if product.featured_media %}
          <img 
            src="{{ product.featured_media | image_url: width: 1200 }}"
            alt="{{ product.featured_media.alt | escape }}"
            class="w-full h-auto object-cover rounded-xl"
            width="{{ product.featured_media.width }}"
            height="{{ product.featured_media.height }}"
          />
        {% endif %}
      </div>
    {% endif %}


      <div class="product-info w-full flex flex-col justify-between items-start h-auto min-w-0">
        <div>

          <div class="hidden md:block w-full">
            {% if show_bundle_quotes %}
              {% render 'product-quote-carousel',
                bg_color: section.settings.per_serving_bg_color,
                suffix: 'desktop'
              %}
            {% elsif quote_text != blank %}
              <div class="product-quote-box" style="background-color: {{ section.settings.per_serving_bg_color }};">
                <p class="product-quote-box__text">&ldquo;{{ quote_text }}&rdquo;</p>
                <div class="product-quote-box__author-row">
                  <span class="product-quote-box__avatar">{{ quote_author | slice: 0 }}</span>
                  <span class="product-quote-box__author">{{ quote_author }}</span>
                  {% if quote_verified %}
                    <span class="product-quote-box__verified">Verified</span>
                  {% endif %}
                </div>
              </div>
            {% endif %}

            <!-- Judge.me reviews -->
            <div class="mb-4" style="margin-top: 24px;">
              <div class='jdgm-widget jdgm-preview-badge jdgm--done' data-id='{{ product.id }}' style="font-size: 1.3rem;">
                {{ product.metafields.judgeme.badge }}
              </div>
            </div>
          </div>


          <h1 class="text-3xl md:text-4xl font-bricolage font-medium text-black mb-4">
            {{ product.title }}
          </h1>


        <div id="priceWrapper" class="py-2 flex flex-col gap-2 transition-all duration-300 w-full">
          {% if section.settings.kickstarter_price %}
            <div id="priceDisplay" class="flex items-center gap-4 transition-all duration-300">
              <span class="text-3xl md:text-4xl text-black">
                {{ current_variant.price | money }}
              </span>
              {% if section.settings.discount_badge_text != blank %}
                <span class="text-xs md:text-sm font-semibold uppercase bg-red-500 text-white px-2 py-1 rounded-full whitespace-nowrap">
                  {{ section.settings.discount_badge_text }}
                </span>
              {% endif %}
            </div>

            <!-- Product Features Row (exclude Filter Bags) -->
            {% unless product.handle == 'filter-bags' %}
              {% render 'product-features-row' %}
            {% endunless %}

            <!-- Descripción con widget embebido donde dice ProductDrop -->
            {% assign desc_parts = product.description | split: 'ProductDrop' %}
            {% assign desc_html = desc_parts[0] | default: '' %}
            {% assign product_intro = desc_html %}
            {% assign product_ingredients = '' %}

            {% assign ingredients_split = desc_html | split: '<strong>Ingredients</strong>:' %}
            {% if ingredients_split.size > 1 %}
              {% assign product_intro = ingredients_split[0] %}
              {% assign product_ingredients = ingredients_split[1] | strip_html | strip %}
            {% else %}
              {% assign ingredients_split = desc_html | split: '<strong>Ingredients</strong><span>:' %}
              {% if ingredients_split.size > 1 %}
                {% assign product_intro = ingredients_split[0] %}
                {% assign product_ingredients = ingredients_split[1] | strip_html | strip %}
              {% else %}
                {% assign ingredients_split = desc_html | split: '<strong>Ingredients:</strong>' %}
                {% if ingredients_split.size > 1 %}
                  {% assign product_intro = ingredients_split[0] %}
                  {% assign product_ingredients = ingredients_split[1] | strip_html | strip %}
                {% else %}
                  {% assign ingredients_split = desc_html | split: 'Ingredients:' %}
                  {% if ingredients_split.size > 1 %}
                    {% assign product_intro = ingredients_split[0] %}
                    {% assign product_ingredients = ingredients_split[1] | strip_html | strip %}
                  {% endif %}
                {% endif %}
              {% endif %}
            {% endif %}

            {% if product_intro != blank %}
              <div class="text-sm text-black font-bricolage product-description md:pr-10">
                {{ product_intro }}
              </div>
            {% endif %}

            {% render 'product-details-accordion',
              ingredients: product_ingredients,
              presentation: section.settings.presentation_text,
              steeping: section.settings.steeping_instructions_text
            %}

            {% if desc_parts[1] != blank %}
              <div class="text-sm text-black font-bricolage product-description md:pr-10">
                {{ desc_parts[1] }}
              </div>
            {% endif %}

            <div id="product-atc-anchor" class="w-full">
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                {% render block %}
              {%- endif -%}
            {%- endfor -%}

            <form method="post" action="{{ routes.cart_add_url }}" id="kickstarterForm" class="w-full">
              <input type="hidden" name="id" id="kickstarterVariantId" value="{{ current_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button
                type="submit"
                id="addToCartKickstarter"
                {% unless current_variant.available %}disabled{% endunless %}
                class="flex items-center justify-center w-full rounded-3xl py-3
                      hover:opacity-70 transition-opacity disabled:opacity-50 cursor-pointer"
                style="background-color: {{ section.settings.per_serving_bg_color }}; color: {{ section.settings.per_serving_text_color }};"
              >
                <span class="font-bricolage xl:text-xl text-sm text-center uppercase font-light px-10">
                  {% if current_variant.available %}
                    {{ section.settings.text_kickstarter_button }}
                  {% else %}
                    {{ section.settings.sold_out_text }}
                  {% endif %}
                </span>
              </button>
            </form>
            </div>

          {% else %}
            <div id="priceDisplay" class="flex items-center gap-4 transition-all duration-300">
              <span class="text-2xl md:text-3xl text-gray-700">
                {{ current_variant.price | money }}
              </span>
              {% if section.settings.discount_badge_text != blank %}
                <span class="text-xs md:text-sm font-semibold uppercase bg-red-500 text-white px-2 py-1 rounded-full whitespace-nowrap">
                  {{ section.settings.discount_badge_text }}
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>

        <!-- Variantes -->
        {% unless product.has_only_default_variant %}
          {% assign first_variant = product.selected_or_first_available_variant %}
          <p class="font-bricolage md:text-lg text-sm pt-3">Quantity:</p>
          <div class="w-full grid grid-cols-4 md:gap-4 gap-3 pt-5">
            {% for variant in product.variants %}
              {% assign parts = variant.title | split: '/' %}
              {% assign descount = parts[0] | strip %}
              {% assign cant = parts[1] | strip | remove: 'gr' | strip %}

              <div
                class="variant-option rounded-xl w-full h-full flex flex-col
                      cursor-pointer border border-gray-400
                      transition-all duration-300 overflow-hidden
                      {% if variant.id == first_variant.id %}ring-2 ring-black scale-105{% endif %}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price | money }}"
                data-price-raw="{{ variant.price }}"
              >
                <div class="w-full bg-gray-800 flex items-center justify-center h-15 md:h-14">
                  <p class="font-bricolage md:text-md text-xs text-center text-white px-2 leading-tight">
                    {{ descount }}
                  </p>
                </div>
                <div class="flex-1 w-full flex items-center justify-center py-2">
                  <p class="font-bricolage md:text-lg text-sm">{{ cant }}</p>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endunless %}
      </div>

      {% unless section.settings.kickstarter_price %}
        <form method="post" action="{{ routes.cart_add_url }}" id="product-atc-anchor" class="w-full py-4 items-end text-center mx-auto cursor-pointer">
          <input type="hidden" name="id" id="variantInput" value="{{ current_variant.id }}">
          <button
            type="submit"
            {% unless current_variant.available %}disabled{% endunless %}
            class="bg-gray-800 flex items-center justify-center w-full rounded-3xl py-3 
                  hover:opacity-70 transition-opacity disabled:opacity-50"
          >
            <span class="font-bricolage text-white xl:text-sm text-md uppercase font-light">
              {% if current_variant.available %}
                {{ section.settings.text_button }}
              {% else %}
                {{ section.settings.sold_out_text }}
              {% endif %}
            </span>
          </button>
        </form>
      {% endunless %}

      {% if section.settings.disclaimer_kickstarter != blank %}
        <div>
          <p class="text-sm text-gray-500 font-bricolage italic pb-2">
            {{ section.settings.disclaimer_kickstarter }}
          </p>
        </div>
      {% endif %}
    </div>

  {% else %}
    <div class="col-span-2 text-center text-sm text-gray-500">No product selected in section settings.</div>
  {% endif %}

</div>

  <!-- Floating Add-to-Cart Button -->
  <div class="product-floating-button" id="productFloatingButton">
    <div class="product-floating-button__wrapper">
      <form method="post" action="{{ routes.cart_add_url }}" id="floatingCartForm" class="w-full">
        <input type="hidden" name="id" id="floatingVariantId">
        <input type="hidden" name="quantity" value="1">
        <button
          type="submit"
          id="floatingAddToCartBtn"
          class="flex items-center justify-center w-full rounded-3xl py-3 hover:opacity-70 transition-opacity disabled:opacity-50 cursor-pointer"
        >
          <span class="font-bricolage text-sm uppercase font-light">{{ section.settings.text_kickstarter_button }}</span>
        </button>
      </form>
    </div>
  </div>

<script>
  const variants = document.querySelectorAll('.variant-option');
  const priceWrapper = document.getElementById('priceWrapper');
  const variantInput = document.getElementById('variantInput');

  variants.forEach(option => {
    option.addEventListener('click', () => {
      variants.forEach(v => v.classList.remove('ring-2', 'ring-black', 'scale-105'));
      option.classList.add('ring-2', 'ring-black', 'scale-105');

      // Actualizar form normal (modo no-kickstarter)
      if (variantInput) variantInput.value = option.dataset.variantId;

      // Actualizar form kickstarter
      const ksVariantInput = document.getElementById('kickstarterVariantId');
      if (ksVariantInput) ksVariantInput.value = option.dataset.variantId;

      const priceDisplay = document.getElementById('priceDisplay');
      if (priceDisplay) {
        priceDisplay.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => {
          const price = option.dataset.price;
          priceDisplay.innerHTML = `<span class="text-3xl md:text-4xl text-black">${price}</span>`;
          priceDisplay.classList.remove('opacity-0', 'translate-y-2');
        }, 200);
      }
    });
  });

  // Re-habilitar botón kickstarter si el navegador restaura desde caché
  window.addEventListener('pageshow', () => {
    const ksBtn = document.getElementById('addToCartKickstarter');
    if (ksBtn) ksBtn.disabled = false;
  });

  // Bundle quote carousel (Hydra / Gut Bliss / Chill)
  (function() {
    document.querySelectorAll('[data-quote-carousel]').forEach((carousel) => {
      const track = carousel.querySelector('.product-quote-carousel__track');
      const dots = carousel.querySelectorAll('.product-quote-carousel__dot');
      if (!track || !dots.length) return;

      let index = 0;
      let startX = 0;
      let dragging = false;

      function goTo(i) {
        index = Math.max(0, Math.min(i, dots.length - 1));
        track.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((dot, d) => {
          dot.classList.toggle('is-active', d === index);
        });
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          goTo(Number(dot.dataset.index) || 0);
        });
      });

      track.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
        dragging = true;
      }, { passive: true });

      track.addEventListener('touchmove', (e) => {
        if (!dragging) return;
        const diff = startX - e.touches[0].clientX;
        if (Math.abs(diff) > 50) {
          goTo(diff > 0 ? index + 1 : index - 1);
          dragging = false;
        }
      }, { passive: true });

      track.addEventListener('touchend', () => {
        dragging = false;
      });

      goTo(0);
    });
  })();

  // Floating Add-to-Cart Button: Intersection Observer and State Sync
  (function() {
    const floatingButton = document.getElementById('productFloatingButton');
    const floatingVariantId = document.getElementById('floatingVariantId');
    const floatingAddBtn = document.getElementById('floatingAddToCartBtn');

    if (!floatingButton || !floatingVariantId || !floatingAddBtn) return;

    const mainButton = document.getElementById('addToCartKickstarter') ||
      document.querySelector('#product-atc-anchor button[type="submit"]') ||
      document.querySelector('form:not(#floatingCartForm)[action*="/cart/add"] button[type="submit"]');
    const anchor = document.getElementById('product-atc-anchor') || mainButton;
    if (!anchor) return;

    const intersectionObserver = new IntersectionObserver((entries) => {
      const entry = entries[0];
      if (!entry) return;
      floatingButton.classList.toggle('is-visible', !entry.isIntersecting);
    }, { threshold: 0, rootMargin: '0px 0px -80px 0px' });

    intersectionObserver.observe(anchor);

    // Sync variant ID when variant selection changes
    function syncVariantID() {
      const ksInput = document.getElementById('kickstarterVariantId');
      if (ksInput) {
        floatingVariantId.value = ksInput.value;
      }
    }

    // Listen to variant clicks
    document.querySelectorAll('.variant-option').forEach(option => {
      option.addEventListener('click', syncVariantID);
    });

    // Sync button text and disabled state
    function syncButtonState() {
      if (!mainButton) return;
      const isDisabled = mainButton.disabled;
      floatingAddBtn.disabled = isDisabled;
      floatingAddBtn.textContent = isDisabled ?
        '{{ section.settings.sold_out_text }}' :
        '{{ section.settings.text_kickstarter_button }}';
    }

    function syncColors() {
      if (!mainButton) return;
      const mainStyle = window.getComputedStyle(mainButton);
      floatingAddBtn.style.backgroundColor = mainStyle.backgroundColor;
      floatingAddBtn.style.color = mainStyle.color;
    }

    syncVariantID();
    if (mainButton) {
      const stateObserver = new MutationObserver(syncButtonState);
      stateObserver.observe(mainButton, { attributes: true, attributeFilter: ['disabled'] });
      syncButtonState();
      syncColors();
      setTimeout(syncColors, 100);
    }
  })();
</script>

<script>
  let currentSlide = 0;
  let autoplayInterval = null;

  function updateThumbnails(scrollToThumb = false) {
    const thumbs = document.querySelectorAll('.thumbnail-btn');
    thumbs.forEach((thumb, i) => {
      if (i === currentSlide) {
        thumb.classList.add('border-black', 'opacity-100');
        thumb.classList.remove('border-transparent', 'opacity-60');
        if (scrollToThumb) {
          thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      } else {
        thumb.classList.remove('border-black', 'opacity-100');
        thumb.classList.add('border-transparent', 'opacity-60');
      }
    });
  }

  function goToSlide(index) {
    const track = document.getElementById("sliderTrack");
    currentSlide = index;
    track.style.transform = `translateX(-${currentSlide * 100}%)`;
    updateThumbnails(true);
  }

  function slideNext() {
    const track = document.getElementById("sliderTrack");
    const slides = track.children.length;
    currentSlide = (currentSlide + 1) % slides;
    track.style.transform = `translateX(-${currentSlide * 100}%)`;
    updateThumbnails();
  }

  function slidePrev() {
    const track = document.getElementById("sliderTrack");
    const slides = track.children.length;
    currentSlide = (currentSlide - 1 + slides) % slides;
    track.style.transform = `translateX(-${currentSlide * 100}%)`;
    updateThumbnails();
  }

  function startAutoplay() {
    autoplayInterval = setInterval(slideNext, 3500);
  }

  function stopAutoplay() {
    clearInterval(autoplayInterval);
  }

  const slider = document.getElementById('productSlider');
  if (slider) {
    slider.addEventListener('mouseenter', stopAutoplay);
    slider.addEventListener('mouseleave', startAutoplay);
    slider.addEventListener('touchstart', stopAutoplay, { passive: true });
    slider.addEventListener('touchend', startAutoplay, { passive: true });
    startAutoplay();
  }

  // Desktop grid: navegación principal
  const desktopThumbs = document.querySelectorAll('.desktop-thumb');
  const mainWrapper = document.getElementById('mainImageDesktop');
  let desktopIndex = 0;

  function desktopGoTo(index) {
    const thumbsArr = Array.from(desktopThumbs);
    desktopIndex = (index + thumbsArr.length) % thumbsArr.length;
    const btn = thumbsArr[desktopIndex];

    thumbsArr.forEach(b => {
      b.classList.remove('border-black', 'opacity-100');
      b.classList.add('border-transparent', 'opacity-60');
    });
    btn.classList.remove('border-transparent', 'opacity-60');
    btn.classList.add('border-black', 'opacity-100');

    const type = btn.dataset.type;
    if (type === 'video' || type === 'external_video') {
      let img = mainWrapper.querySelector('img');
      if (img) img.remove();
      let vid = mainWrapper.querySelector('video');
      if (!vid) {
        vid = document.createElement('video');
        vid.autoplay = true; vid.loop = true; vid.muted = true; vid.playsInline = true;
        vid.className = 'w-full h-auto block';
        mainWrapper.insertBefore(vid, mainWrapper.querySelector('button'));
      }
      vid.src = btn.dataset.video;
      vid.load(); vid.play();
    } else {
      let vid = mainWrapper.querySelector('video');
      if (vid) vid.remove();
      let img = mainWrapper.querySelector('img');
      if (!img) {
        img = document.createElement('img');
        img.className = 'w-full h-auto block';
        mainWrapper.insertBefore(img, mainWrapper.querySelector('button'));
      }
      img.src = btn.dataset.src;
      img.alt = btn.dataset.alt;
    }
  }

  function desktopNext() { desktopGoTo(desktopIndex + 1); }
  function desktopPrev() { desktopGoTo(desktopIndex - 1); }

  desktopThumbs.forEach((btn, i) => {
    btn.addEventListener('click', () => desktopGoTo(i));
  });
</script>

{% stylesheet %}
  .product-quote-box {
    width: 100%;
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.25rem;
  }

  .product-quote-box__text {
    font-family: var(--font-bricolage, sans-serif);
    font-size: 1rem;
    font-style: italic;
    line-height: 1.5;
    color: #1a1a1a;
    margin-bottom: 0.75rem;
  }

  .product-quote-box__author-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .product-quote-box__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    background-color: rgba(0, 0, 0, 0.12);
    color: #1a1a1a;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .product-quote-box__author {
    font-family: var(--font-bricolage, sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    color: #1a1a1a;
  }

  .product-quote-box__verified {
    font-family: var(--font-bricolage, sans-serif);
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(26, 26, 26, 0.6);
  }

  .product-quote-carousel__slide .product-quote-box {
    margin-bottom: 0.75rem;
  }

  .product-quote-carousel__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background-color: #d1d5db;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: width 0.2s ease, background-color 0.2s ease;
  }

  .product-quote-carousel__dot.is-active {
    width: 1.5rem;
    background-color: #1a1a1a;
  }

  /* Floating Add-to-Cart Button */
  .product-floating-button {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 40;
    background: white;
    padding: 1rem 1rem max(1rem, env(safe-area-inset-bottom));
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.1);
    transform: translateY(calc(100% + 12px));
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.3s ease-out, visibility 0.3s ease-out;
  }

  .product-floating-button.is-visible {
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
  }

  .product-floating-button__wrapper {
    max-width: 100%;
  }

  .product-floating-button button {
    min-height: 48px;
  }

  @media (min-width: 768px) {
    .product-floating-button__wrapper {
      max-width: 480px;
      margin: 0 auto;
    }
  }
{% endstylesheet %}

