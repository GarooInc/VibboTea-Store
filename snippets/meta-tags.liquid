<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign meta_description = page_description
  if meta_description == blank
    case request.page_type
      when 'product'
        assign meta_description = product.description | strip_html | strip | truncate: 155
      when 'collection'
        assign meta_description = collection.description | strip_html | strip | truncate: 155
      when 'article'
        assign meta_description = article.excerpt_or_content | strip_html | strip | truncate: 155
      when 'page'
        assign meta_description = page.content | strip_html | strip | truncate: 155
      when 'blog'
        assign meta_description = blog.title | append: ' — ' | append: shop.name
    endcase
  endif
  if meta_description == blank
    assign meta_description = shop.description
  endif

  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = meta_description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  {%- comment -%}
    Datos de la etiqueta (metafields seo_facts.*, cargados en el admin) para
    Google y los buscadores con IA. No se muestran en la pagina: el cliente no
    aprueba cambios visibles, asi que esto suma contexto sin tocar textos.
    Mismo @id que el Product de structured_data y de Judge.me, para que Google
    los una en un solo producto en vez de verlos como tres.
  {%- endcomment -%}
  {%- assign facts = product.metafields.seo_facts -%}
  {%- if facts.ingredients != blank -%}
    {%- assign net_weight = facts.net_weight.value -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "@id": {{ '/products/' | append: product.handle | append: '#product' | json }},
        {%- comment -%}
          Mismo nombre que manda structured_data (el Vendor, "Vibbo-tea") para
          no contradecirlo; "VIBBO" va como nombre alterno, que es como la
          gente conoce la marca.
        {%- endcomment -%}
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }},
          "alternateName": ["VIBBO", "VIBBO Tea"]
        },
        "countryOfOrigin": { "@type": "Country", "name": "Guatemala" },
        {%- if net_weight -%}
          "weight": {
            "@type": "QuantitativeValue",
            "value": {{ net_weight.value | json }},
            "unitText": {{ net_weight.unit | json }}
          },
        {%- endif -%}
        "additionalProperty": [
          { "@type": "PropertyValue", "name": "Ingredients", "value": {{ facts.ingredients.value | json }} }
          {%- if facts.caffeine != blank -%}
            ,{ "@type": "PropertyValue", "name": "Caffeine", "value": {{ facts.caffeine.value | json }} }
          {%- endif -%}
          {%- if facts.servings != blank -%}
            ,{ "@type": "PropertyValue", "name": "Servings per container", "value": {{ facts.servings.value | json }} }
          {%- endif -%}
          {%- if facts.calories != blank -%}
            ,{ "@type": "PropertyValue", "name": "Calories per serving", "value": {{ facts.calories.value | json }} }
          {%- endif -%}
          ,{ "@type": "PropertyValue", "name": "Format", "value": "Loose-leaf tea with biodegradable tea bags" }
        ]
      }
    </script>
  {%- endif -%}

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- if settings.favicon -%}
  <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 64 }}" type="image/png">
{%- endif -%}

{% if meta_description != blank %}
  <meta
    name="description"
    content="{{ meta_description | escape }}"
  >
{% endif %}

{%- comment -%}
  JSON-LD para Google. Vive aqui y no en un snippet aparte porque la
  sincronizacion de GitHub de Shopify no subia el archivo nuevo y cada pagina
  quedaba con un Liquid error en el <head>.

  - Organization: solo en la home, que es donde Google espera la entidad de
    marca. Repetirlo en cada URL no aporta y ensucia. Sin WebSite/SearchAction:
    Google retiro el sitelinks searchbox en 2024.
  - BreadcrumbList: en producto, coleccion, blog y articulo.
  - Article: en las paginas de articulo.
  El `product | structured_data` de arriba cubre las fichas de producto.
{%- endcomment -%}

{%- liquid
  assign brand_logo = settings.seo_logo | default: settings.favicon

  assign socials = ''
  if settings.social_instagram != blank
    assign socials = socials | append: settings.social_instagram | append: '|'
  endif
  if settings.social_facebook != blank
    assign socials = socials | append: settings.social_facebook | append: '|'
  endif
  if settings.social_tiktok != blank
    assign socials = socials | append: settings.social_tiktok | append: '|'
  endif
  if settings.social_x != blank
    assign socials = socials | append: settings.social_x | append: '|'
  endif
  if settings.social_youtube != blank
    assign socials = socials | append: settings.social_youtube | append: '|'
  endif
  assign social_list = socials | split: '|'
-%}

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": {{ request.origin | append: '/#organization' | json }},
      "name": {{ shop.name | json }},
      "url": {{ request.origin | json }},
      {%- comment -%}
        Desambiguacion para las IAs: sin busqueda web, un asistente confundio
        "Vibbo Tea" con una cadena de bubble tea (oct 2026). Esta linea dice
        explicitamente que es y que no es la marca.
      {%- endcomment -%}
      "disambiguatingDescription": "VIBBO is a loose-leaf functional tea brand with ingredients sourced in Guatemala and sold online in the United States at drinkvibbo.com. It is not a bubble tea or boba shop."
      {%- if brand_logo != blank -%}
        ,"logo": {{ brand_logo | image_url: width: 600 | prepend: 'https:' | json }}
      {%- endif -%}
      {%- if shop.description != blank -%}
        ,"description": {{ shop.description | json }}
      {%- endif -%}
      {%- if settings.brand_alt_names != blank -%}
        ,"alternateName": [
          {%- assign alt_names = settings.brand_alt_names | split: ',' -%}
          {%- for alt in alt_names -%}
            {{ alt | strip | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      {%- endif -%}
      {%- if settings.brand_founding_country != blank -%}
        ,"foundingLocation": {
          "@type": "Country",
          "name": {{ settings.brand_founding_country | json }}
        }
      {%- endif -%}
      {%- if settings.brand_areas_served != blank -%}
        ,"areaServed": [
          {%- assign areas = settings.brand_areas_served | split: ',' -%}
          {%- for area in areas -%}
            { "@type": "Country", "name": {{ area | strip | json }} }
            {%- unless forloop.last %},{% endunless -%}
          {%- endfor -%}
        ]
      {%- endif -%}
      {%- if shop.email != blank -%}
        ,"contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "email": {{ shop.email | json }},
          "url": {{ request.origin | append: '/pages/contact-us' | json }}
        }
      {%- endif -%}
      {%- if social_list.size > 0 -%}
        ,"sameAs": [
          {%- for url in social_list -%}
            {{ url | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      {%- endif -%}
    }
  </script>

{%- endif -%}

{%- if request.page_type == 'article' and article != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical_url | json }} },
      "headline": {{ article.title | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "author": { "@type": "Person", "name": {{ article.author | default: shop.name | json }} },
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
        {%- if brand_logo != blank -%}
          ,"logo": {
            "@type": "ImageObject",
            "url": {{ brand_logo | image_url: width: 600 | prepend: 'https:' | json }}
          }
        {%- endif -%}
      }
      {%- if article.image != blank -%}
        ,"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}
      {%- endif -%}
      {%- if article.excerpt_or_content != blank -%}
        ,"description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }}
      {%- endif -%}
    }
  </script>
{%- endif -%}

{%- liquid
  assign show_breadcrumbs = false
  case request.page_type
    when 'product', 'collection', 'blog', 'article'
      assign show_breadcrumbs = true
  endcase
-%}

{%- if show_breadcrumbs -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ request.origin | json }}
        }
        {%- case request.page_type -%}
          {%- when 'product' -%}
            {%- if collection != blank -%}
              ,{
                "@type": "ListItem",
                "position": 2,
                "name": {{ collection.title | json }},
                "item": {{ collection.url | prepend: request.origin | json }}
              },
              {
                "@type": "ListItem",
                "position": 3,
                "name": {{ product.title | json }},
                "item": {{ canonical_url | json }}
              }
            {%- else -%}
              ,{
                "@type": "ListItem",
                "position": 2,
                "name": {{ product.title | json }},
                "item": {{ canonical_url | json }}
              }
            {%- endif -%}
          {%- when 'collection' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": {{ canonical_url | json }}
            }
          {%- when 'blog' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ canonical_url | json }}
            }
          {%- when 'article' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ blog.url | prepend: request.origin | json }}
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ article.title | json }},
              "item": {{ canonical_url | json }}
            }
        {%- endcase -%}
      ]
    }
  </script>
{%- endif -%}
